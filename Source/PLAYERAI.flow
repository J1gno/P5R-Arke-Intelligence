void ACT_EmergencyRezAndHeal()
{
    int id;
    int uid;
    int maxHp;
    int hpPct;
    int bestPct;
    int critChar;
    int critCount;
    int badChar;

    if (sLockMode == 4)
    {
        return;
    }

    ACT_Rez();
    if (sActionDone != 0)
    {
        return;
    }

    critChar = 0;
    bestPct = 101;
    critCount = 0;
    id = 10;
    while (id >= 1)
    {
        if (IsAllyAlive(id) == 1)
        {
            uid = AI_GET_UNI(0, id);
            if (uid != -1)
            {
                maxHp = AI_GET_P_MAX_HP(uid);
                if (maxHp > 0)
                {
                    hpPct = (100 * AI_GET_P_NOW_HP(uid)) / maxHp;
                    if (hpPct <= 30)
                    {
                        critCount = critCount + 1;
                        if (hpPct <= bestPct)
                        {
                            bestPct = hpPct;
                            critChar = id;
                        }
                    }
                }
            }
        }
        id = id - 1;
    }

    if (critCount >= 2)
    {
        if (AI_CHK_MYABLESKIL(306) == 1)
        {
            AI_ACT_SKILL(306);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
        if (AI_CHK_MYABLESKIL(307) == 1)
        {
            AI_ACT_SKILL(307);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
        if (AI_CHK_MYABLESKIL(305) == 1)
        {
            AI_ACT_SKILL(305);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
        if ((sLockMode != 7) && (AI_CHK_MYABLESKIL(318) == 1))
        {
            AI_ACT_SKILL(318);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
    }

    if (critChar != 0)
    {
        if (AI_CHK_MYABLESKIL(301) == 1)
        {
            AI_ACT_SKILL(301);
            AI_TAR_UID(AI_GET_UNI(0, critChar));
            sActionDone = 10;
            return;
        }
        if ((sLockMode != 3) && (AI_CHK_MYABLESKIL(183) == 1))
        {
            AI_ACT_SKILL(183);
            AI_TAR_UID(AI_GET_UNI(0, critChar));
            sActionDone = 10;
            return;
        }
        if (AI_CHK_MYABLESKIL(302) == 1)
        {
            AI_ACT_SKILL(302);
            AI_TAR_UID(AI_GET_UNI(0, critChar));
            sActionDone = 10;
            return;
        }
        if (AI_CHK_MYABLESKIL(300) == 1)
        {
            AI_ACT_SKILL(300);
            AI_TAR_UID(AI_GET_UNI(0, critChar));
            sActionDone = 10;
            return;
        }
        if (AI_CHK_MYABLESKIL(306) == 1)
        {
            AI_ACT_SKILL(306);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
        if (AI_CHK_MYABLESKIL(307) == 1)
        {
            AI_ACT_SKILL(307);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
        if (AI_CHK_MYABLESKIL(305) == 1)
        {
            AI_ACT_SKILL(305);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
        if ((sLockMode != 7) && (AI_CHK_MYABLESKIL(318) == 1))
        {
            AI_ACT_SKILL(318);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
    }

    // 0x0C00 = Despair (0x0400) | Brainwash (0x0800)
    if ((sLockMode != 7) && (AI_CHK_FRBAD(0x0C00) == 1))
    {
        badChar = 0;
        id = 10;
        while (id >= 1)
        {
            if (IsAllyAlive(id) == 1)
            {
                if (AI_CHK_FRIDBAD(id, 0x0C00) == 1)
                {
                    badChar = id;
                }
            }
            id = id - 1;
        }
        if (badChar != 0)
        {
            if (AI_CHK_MYABLESKIL(328) == 1)
            {
                AI_ACT_SKILL(328);
                AI_TAR_UID(AI_GET_UNI(0, badChar));
                sActionDone = 10;
                return;
            }
            if (AI_CHK_MYABLESKIL(315) == 1)
            {
                AI_ACT_SKILL(315);
                AI_TAR_UID(AI_GET_UNI(0, badChar));
                sActionDone = 10;
                return;
            }
            if (AI_CHK_MYABLESKIL(327) == 1)
            {
                AI_ACT_SKILL(327);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
            if ((sLockMode != 3) && (AI_CHK_MYABLESKIL(186) == 1))
            {
                AI_ACT_SKILL(186);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
            if (AI_CHK_MYABLESKIL(316) == 1)
            {
                AI_ACT_SKILL(316);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
            if ((badChar == 1) && (AI_CHK_MYABLESKIL(318) == 1))
            {
                AI_ACT_SKILL(318);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
        }
    }
}

void ACT_CureAilment()
{
    int id;
    int elemCount;    // 0x0007: Burn (0x01) | Freeze (0x02) | Shock (0x04)
    int patraCount;   // 0x01C8: Dizzy (0x08) | Forget (0x40) | Hunger (0x80) | Sleep (0x100)
    int energyCount;  // 0x0E30: Confuse (0x10) | Fear (0x20) | Rage (0x200) | Despair (0x400) | Brainwash (0x800)
    int totalCount;
    int elemChar;
    int patraChar;
    int energyChar;
    int anyChar;
    int res;

    if ((sLockMode == 4) || (sLockMode == 7))
    {
        return;
    }

    if (AI_CHK_FRBAD(0x0FFF) == 0)
    {
        return;
    }

    elemCount = 0;
    patraCount = 0;
    energyCount = 0;
    elemChar = 0;
    patraChar = 0;
    energyChar = 0;
    anyChar = 0;

    id = 10;
    while (id >= 1)
    {
        if (IsAllyAlive(id) == 1)
        {
            if (AI_CHK_FRIDBAD(id, 0x0007) == 1)
            {
                elemCount = elemCount + 1;
                elemChar = id;
                anyChar = id;
            }
            if (AI_CHK_FRIDBAD(id, 0x01C8) == 1)
            {
                patraCount = patraCount + 1;
                patraChar = id;
                anyChar = id;
            }
            if (AI_CHK_FRIDBAD(id, 0x0E30) == 1)
            {
                energyCount = energyCount + 1;
                energyChar = id;
                anyChar = id;
            }
        }
        id = id - 1;
    }

    totalCount = elemCount + patraCount + energyCount;
    if (totalCount == 0)
    {
        return;
    }

    if (totalCount >= 2)
    {
        if ((energyCount == totalCount) && (AI_CHK_MYABLESKIL(327) == 1))
        {
            AI_ACT_SKILL(327);
            AI_TAR_RND();
            sActionDone = 10;
            return;
