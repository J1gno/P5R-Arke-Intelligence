// P5R Tactics Rewritten
// Author: J1gno | Based on work by cold_spirit (https://gamebanana.com/mods/630268)
// Compile target: BASE.CPK -> BATTLE/SCRIPT/PLAYERAI.BF (FlowScript V3BE / P5R)

int sActionDone;      // 0=undecided, 1=deferred (sSkillId/sTargetUid), 10=issued
int sTargetUid;
int sSkillId;

int sMyUid;
int sMyCharId;        // Party character ID 1..10 (8 = navigator, skipped in combatant loops)
int sOrder;           // 0=ActFreely, 1=FullAssault, 2=ConserveSP, 3=HealSupport
int sMyHpPct;
int sMySpPct;

int sIsBoss;
int sIsUnstable;      // Disaster Shadow present
int sIsHouma;         // Treasure Demon present
int sNotPhysical;     // 1 when melee/Phys is blocked (flying enemies)
int sLockMode;        // Scripted battle lockout (BIT 11634 + COUNT 214): 1=Phys/Gun 2=Magic 3=Support 4=Heal 5=Guard 6=BatonPass 7=Ailment/Rez
int sSingleOnlyFlag;  // BIT 11601: single-target only
int sNo1MoreFlag;     // BIT 11618: disable 1-More / Gun / affinity probing
int sNoFinishFlag;    // BIT 11718: disable melee end-battle finisher
int sAilmentPrioFlag; // BIT 11715: prioritize ailment skills

int sEnemyCount;
int sDownCount;
int sIsHealerChar;
int sIsSupportChar;

// Procedure Index 0: Engine Entry Point (MUST remain index 0)
void main_AI_routine()
{
    Initialize();

    if (AI_CHK_EXCEPTION() == 1)
    {
        return;
    }

    // Mouse (0x00400000): skills, Gun, Showtime & Baton Pass are disabled.
    if (AI_CHK_MYBAD(0x00400000) == 1)
    {
        ACT_ChargeGuard();
        if (sActionDone != 0)
        {
            return;
        }
        if (sLockMode != 5)
        {
            AI_ACT_DEFENSE();
            sActionDone = 10;
            return;
        }
        AI_ACT_ATTACK();
        AI_TAR_RND();
        sActionDone = 10;
        return;
    }

    // Forget (0x40): Persona skills disabled; still allow melee finisher, Guard, Gun & Baton Pass.
    if (AI_CHK_MYBAD(0x40) == 1)
    {
        ACT_EndBattle_ATK();
        if (sActionDone != 0)
        {
            return;
        }
        ACT_ChargeGuard();
        if (sActionDone != 0)
        {
            return;
        }
        ACT_GunWeakOrKill();
        if (sActionDone != 0)
        {
            return;
        }
        ACT_Takeover();
        if (sActionDone != 0)
        {
            return;
        }
        ACT_AttackOrGuard();
        return;
    }

    if (sOrder == 0)
    {
        AI_pattern_Free();
    }
    else if (sOrder == 1)
    {
        AI_pattern_Damage();
    }
    else if (sOrder == 2)
    {
        AI_pattern_SaveSP();
    }
    else if (sOrder == 3)
    {
        AI_pattern_SaveHP();
    }
    else
    {
        ACT_AttackOrGuard();
    }

    if (sActionDone == 10)
    {
        return;
    }
    else if (sActionDone == 1)
    {
        AI_ACT_SKILL(sSkillId);
        AI_TAR_UID(sTargetUid);
        return;
    }

    ACT_AttackOrGuard();
}

int IsAllyAlive(int charId)
{
    if (charId == 8)
    {
        return 0;
    }
    if (AI_CHK_ID_FRTARGET(charId) != 1)
    {
        return 0;
    }
    if (AI_CHK_FRIDBAD(charId, 0x00080000) == 1)
    {
        return 0;
    }
    return 1;
}

// 0x0F3E = Freeze|Shock|Dizzy|Confuse|Fear|Sleep|Rage|Despair|Brainwash; 0x00400000 = Mouse
int IsAllyCapable(int charId)
{
    if (IsAllyAlive(charId) == 0)
    {
        return 0;
    }
    if ((AI_CHK_FRIDBAD(charId, 0x0F3E) == 1) || (AI_CHK_FRIDBAD(charId, 0x00400000) == 1))
    {
        return 0;
    }
    return 1;
}

int IsAllySkillCapable(int charId)
{
    if (IsAllyCapable(charId) == 0)
    {
        return 0;
    }
    if (AI_CHK_FRIDBAD(charId, 0x40) == 1)
    {
        return 0;
    }
    return 1;
}

int CountCapableWithoutHojo(int mask)
{
    int id;
    int cnt;
    cnt = 0;
    id = 1;
    while (id <= 10)
    {
        if (id != 8)
        {
            if (IsAllySkillCapable(id) == 1)
            {
                if (AI_CHK_FRIDHOJO(id, mask) == 0)
                {
                    cnt = cnt + 1;
                }
            }
        }
        id = id + 1;
    }
    return cnt;
}

int IsSinglePhysSafe()
{
    if ((AI_CHK_ENMUKOU(0) == 1) || (AI_CHK_ENHANSYA(0) == 1) || (AI_CHK_ENKYUSYU(0) == 1) || (AI_CHK_ENHOJO(0x4000) == 1))
    {
        return 0;
    }
    return 1;
}

int IsAoESafeForAttr(int attr)
{
    if (sEnemyCount <= 1)
    {
        return 0;
    }
    if (sIsUnstable == 1)
    {
        return 0;
    }
    if (sSingleOnlyFlag == 1)
    {
        return 0;
    }
    if (((attr == 0) || (attr == 1)) && (AI_CHK_ENHOJO(0x4000) == 1))
    {
        return 0;
    }
    if ((attr >= 2) && (attr <= 9) && (AI_CHK_ENHOJO(0x8000) == 1))
    {
        return 0;
    }
    if (AI_CHK_ENMUKOU(attr) == 1)
    {
        return 0;
    }
    if (AI_CHK_ENHANSYA(attr) == 1)
    {
        return 0;
    }
    if (AI_CHK_ENKYUSYU(attr) == 1)
    {
        return 0;
    }
    return 1;
}

int IsAoEGunSafe()
{
    if ((sEnemyCount > 1) && (sIsUnstable == 1))
    {
        return 0;
    }
    if ((sEnemyCount > 1) && (sSingleOnlyFlag == 1))
    {
        return 0;
    }
    if (AI_CHK_ENHOJO(0x4000) == 1)
    {
        return 0;
    }
    if (AI_CHK_ENMUKOU(1) == 1)
    {
        return 0;
    }
    if (AI_CHK_ENHANSYA(1) == 1)
    {
        return 0;
    }
    if (AI_CHK_ENKYUSYU(1) == 1)
    {
        return 0;
    }
    return 1;
}

int IsAttrKnownImpeded(int attr)
{
    int uid;
    uid = AI_GET_UNIRESIST(attr);
    if (uid != -1) { if (AI_CHK_UNIANALYZE_OPEN(uid, attr) == 1) { return 1; } }
    uid = AI_GET_UNIMUKOU(attr);
    if (uid != -1) { if (AI_CHK_UNIANALYZE_OPEN(uid, attr) == 1) { return 1; } }
    uid = AI_GET_UNIHANSYA(attr);
    if (uid != -1) { if (AI_CHK_UNIANALYZE_OPEN(uid, attr) == 1) { return 1; } }
    uid = AI_GET_UNIKYUSYU(attr);
    if (uid != -1) { if (AI_CHK_UNIANALYZE_OPEN(uid, attr) == 1) { return 1; } }
    return 0;
}

int IsAttrKnownImmune(int attr)
{
    int uid;
    uid = AI_GET_UNIMUKOU(attr);
    if (uid != -1) { if (AI_CHK_UNIANALYZE_OPEN(uid, attr) == 1) { return 1; } }
    uid = AI_GET_UNIHANSYA(attr);
    if (uid != -1) { if (AI_CHK_UNIANALYZE_OPEN(uid, attr) == 1) { return 1; } }
    uid = AI_GET_UNIKYUSYU(attr);
    if (uid != -1) { if (AI_CHK_UNIANALYZE_OPEN(uid, attr) == 1) { return 1; } }
    return 0;
}

void Initialize()
{
    int maxHp;
    int maxSp;

    sActionDone = 0;
    sTargetUid = -1;
    sSkillId = 0;

    sMyUid = AI_GET_MY_ID();
    sMyCharId = BTL_GET_CURRENT_CHARAID();
    sOrder = AI_GET_P_ORDER(sMyUid);

    maxHp = AI_GET_P_MAX_HP(sMyUid);
    if (maxHp > 0)
    {
        sMyHpPct = (100 * AI_GET_P_NOW_HP(sMyUid)) / maxHp;
    }
    else
    {
        sMyHpPct = 100;
    }

    maxSp = AI_GET_P_MAX_SP(sMyUid);
    if (maxSp > 0)
    {
        sMySpPct = (100 * AI_GET_P_NOW_SP(sMyUid)) / maxSp;
    }
    else
    {
        sMySpPct = 0;
    }

    sIsBoss = 0;
    if ((AI_CHK_BOSS() == 1) || (AI_CHK_EXCEPT_ENCOUNT(0) == 1))
    {
        sIsBoss = 1;
    }

    sIsUnstable = AI_CHK_UNSTABLE();
    sIsHouma = AI_CHK_HOUMA();
    sNotPhysical = BTL_CHK_NOTPHYSICAL();
    sEnemyCount = AI_GET_E_NUM();
    sDownCount = AI_GET_ENBAD_ON(0x00100000);

    // 805306368 (0x30000000) = P5R battle flag base (BIT 11634 / 11601 / 11618 / 11718 / 11715)
    sLockMode = 0;
    if (BIT_CHK(805306368 + 370) == 1)
    {
        sLockMode = GET_COUNT(214);
    }

    sSingleOnlyFlag = BIT_CHK(805306368 + 337);
    sNo1MoreFlag = BIT_CHK(805306368 + 354);
    sNoFinishFlag = BIT_CHK(805306368 + 454);
    sAilmentPrioFlag = BIT_CHK(805306368 + 451);

    sIsHealerChar = 0;
    if ((sMyCharId == 3) || (sMyCharId == 6))
    {
        sIsHealerChar = 1;
    }

    sIsSupportChar = 0;
    if ((sMyCharId == 3) || (sMyCharId == 5) || (sMyCharId == 6) || (sMyCharId == 7))
    {
        sIsSupportChar = 1;
    }

    AI_ACT_SKILL(0);
}

// Tactic 0: Act Freely
void AI_pattern_Free()
{
    int roll;

    ACT_EndBattle_ATK();
    if (sActionDone != 0) { return; }

    ACT_ChargeGuard();
    if (sActionDone != 0) { return; }

    ACT_Rez();
    if (sActionDone != 0) { return; }

    // During a 1-More, only critical healing (<=40% HP) or incapacitating ailments (0x0F3E) preempt weakness/Baton Pass chains.
    if (AI_CHK_MORE() == 1)
    {
        ACT_Heal(2);
        if (sActionDone != 0) { return; }
        if (AI_CHK_FRBAD(0x0F3E) == 1)
        {
            ACT_CureAilment();
            if (sActionDone != 0) { return; }
        }
    }
    else
    {
        ACT_Heal(0);
        if (sActionDone != 0) { return; }
        ACT_CureAilment();
        if (sActionDone != 0) { return; }
    }

    ACT_Showtime(0);
    if (sActionDone != 0) { return; }

    ACT_1MoreWeakness(0);
    if (sActionDone != 0) { return; }

    ACT_Takeover();
    if (sActionDone != 0) { return; }

    if (AI_CHK_MORE() == 1)
    {
        ACT_Heal(0);
        if (sActionDone != 0) { return; }
        ACT_CureAilment();
        if (sActionDone != 0) { return; }
    }

    ACT_Fixed();
    if (sActionDone != 0) { return; }

    ACT_Technical();
    if (sActionDone != 0) { return; }

    if (sAilmentPrioFlag == 1)
    {
        ACT_Ailment(1);
        if (sActionDone != 0) { return; }
    }

    ACT_KillEnemy_Gun();
    if (sActionDone != 0) { return; }

    ACT_UrgentDispel();
    if (sActionDone != 0) { return; }

    if (AI_CHK_MYHOJO(0x0300) == 0)
    {
        if ((sIsBoss == 1) || ((sMySpPct >= 25) && (AI_CHK_ENALLHP(30) == 0)))
        {
            roll = RND(100);
            if ((roll < 25) || ((sIsSupportChar == 1) && (roll < 40)) || ((sIsBoss == 1) && (roll < 45)))
            {
                ACT_Support(0);
                if (sActionDone != 0) { return; }
            }
        }
    }

    ACT_ChargeConcentrate(0);
    if (sActionDone != 0) { return; }

    ACT_UnknownAttr();
    if (sActionDone != 0) { return; }

    if ((sAilmentPrioFlag == 0) && (sIsBoss == 0) && (AI_CHK_MYHOJO(0x0300) == 0))
    {
        roll = RND(100);
        if ((roll < 20) || (((sMyCharId == 4) || (sMyCharId == 7)) && (roll < 35)))
        {
            ACT_Ailment(0);
            if (sActionDone != 0) { return; }
        }
    }

    ACT_BestOffense(0);
    if (sActionDone != 0) { return; }

    ACT_GunSmart();
    if (sActionDone != 0) { return; }

    if ((sIsBoss == 1) || ((sMySpPct >= 25) && (AI_CHK_ENALLHP(30) == 0)))
    {
        ACT_Support(0);
        if (sActionDone != 0) { return; }
    }

    if (sIsBoss == 0)
    {
        ACT_Ailment(0);
        if (sActionDone != 0) { return; }
    }

    sActionDone = 0;
}

// Tactic 1: Full Assault
void AI_pattern_Damage()
{
    ACT_EndBattle_ATK();
    if (sActionDone != 0) { return; }

    ACT_ChargeGuard();
    if (sActionDone != 0) { return; }

    ACT_Showtime(1);
    if (sActionDone != 0) { return; }

    ACT_1MoreWeakness(1);
    if (sActionDone != 0) { return; }

    ACT_Takeover();
    if (sActionDone != 0) { return; }

    ACT_Fixed();
    if (sActionDone != 0) { return; }

    ACT_Technical();
    if (sActionDone != 0) { return; }

    ACT_ChargeConcentrate(1);
    if (sActionDone != 0) { return; }

    ACT_UnknownAttr();
    if (sActionDone != 0) { return; }

    ACT_BestOffense(1);
    if (sActionDone != 0) { return; }

    ACT_GunSmart();
    if (sActionDone != 0) { return; }

    if (sIsBoss == 0)
    {
        ACT_Ailment(0);
        if (sActionDone != 0) { return; }
    }

    sActionDone = 0;
}

// Tactic 2: Conserve SP
void AI_pattern_SaveSP()
{
    ACT_EndBattle_ATK();
    if (sActionDone != 0) { return; }

    ACT_ChargeGuard();
    if (sActionDone != 0) { return; }

    ACT_EmergencyRezAndHeal();
    if (sActionDone != 0) { return; }

    ACT_Showtime(0);
    if (sActionDone != 0) { return; }

    ACT_GunWeakOrKill();
    if (sActionDone != 0) { return; }

    ACT_Takeover();
    if (sActionDone != 0) { return; }

    ACT_Fixed();
    if (sActionDone != 0) { return; }

    ACT_PhysZeroSP();
    if (sActionDone != 0) { return; }

    ACT_GunSmart();
    if (sActionDone != 0) { return; }

    sActionDone = 0;
}

// Tactic 3: Heal/Support
void AI_pattern_SaveHP()
{
    ACT_EndBattle_ATK();
    if (sActionDone != 0) { return; }

    ACT_ChargeGuard();
    if (sActionDone != 0) { return; }

    ACT_Rez();
    if (sActionDone != 0) { return; }

    ACT_Heal(1);
    if (sActionDone != 0) { return; }

    ACT_CureAilment();
    if (sActionDone != 0) { return; }

    ACT_Fixed();
    if (sActionDone != 0) { return; }

    ACT_UrgentDispel();
    if (sActionDone != 0) { return; }

    if ((sIsBoss == 1) || ((sMySpPct >= 20) && (AI_CHK_ENALLHP(30) == 0)))
    {
        ACT_Support(1);
        if (sActionDone != 0) { return; }
    }

    ACT_Showtime(0);
    if (sActionDone != 0) { return; }

    ACT_1MoreWeakness(0);
    if (sActionDone != 0) { return; }

    ACT_Takeover();
    if (sActionDone != 0) { return; }

    ACT_SupportRefresh();
    if (sActionDone != 0) { return; }

    if (sIsBoss == 0)
    {
        ACT_Ailment(0);
        if (sActionDone != 0) { return; }
    }

    ACT_GunSmart();
    if (sActionDone != 0) { return; }

    sActionDone = 0;
}

void ACT_EndBattle_ATK()
{
    int myAttr;
    int uid;

    if ((sLockMode == 1) || (sNoFinishFlag == 1) || (sNotPhysical == 1))
    {
        return;
    }

    if (sEnemyCount == 1)
    {
        myAttr = AI_GET_MYATTRATTACK();
        uid = AI_GET_UNIWEAKHPMIN(myAttr);
        if (uid != -1)
        {
            if (AI_CHK_UNIANALYZE_OPEN(uid, myAttr) == 0)
            {
                uid = -1;
            }
        }
        if (uid == -1)
        {
            uid = AI_GET_UNINOMALHPMIN(myAttr);
        }
        if (uid != -1)
        {
            // Skip Shocked (0x04, spreads on melee contact) and Tetrakarn (0x4000).
            if ((AI_CHK_UNIBAD(uid, 4) == 0) && (AI_CHK_UNIHOJO(uid, 0x4000) == 0))
            {
                if (AI_CHK_UNIATTACK(uid) == 1)
                {
                    AI_ACT_ATTACK();
                    AI_TAR_UID(uid);
                    sActionDone = 10;
                    return;
                }
            }
        }
    }
}

void ACT_ChargeGuard()
{
    int res;

    if (sLockMode == 5)
    {
        return;
    }

    res = AI_ACT_GUARDORDER();
    if (res != -1)
    {
        sActionDone = 10;
    }
}

void ACT_Showtime(int aggressive)
{
    if (AI_CHK_SP_ATTACK() != 1)
    {
        return;
    }

    if (sIsHouma == 1)
    {
        return;
    }

    if (((sIsBoss == 1) && (AI_CHK_ENALLHP(10) == 0)) || (sIsUnstable == 1) || ((aggressive == 1) && (AI_CHK_ENALLHP(35) == 0)) || (AI_CHK_FRHP(50) == 1) || ((sEnemyCount >= 2) && (AI_CHK_ENALLHP(65) == 0) && (RND(100) < 50)))
    {
        AI_ACT_SP_ATTACK();
        if (sIsUnstable == 1)
        {
            AI_TAR_UNSTABLE();
        }
        else
        {
            AI_TAR_HPMAX();
        }
        sActionDone = 10;
    }
}

void ACT_Rez()
{
    int res;
    int id;
    int uid;

    if ((sLockMode == 4) || (sLockMode == 7))
    {
        return;
    }

    // 0x00080000 = KO
    if (AI_CHK_FRBAD(0x00080000) == 0)
    {
        return;
    }

    if (AI_CHK_MYABLESKIL(311) == 1)
    {
        if (AI_CHK_FRIDBAD(1, 0x00080000) == 1)
        {
            uid = AI_GET_UNI(0, 1);
            if (uid != -1)
            {
                AI_ACT_SKILL(311);
                AI_TAR_UID(uid);
                sActionDone = 10;
                return;
            }
        }
        id = 2;
        while (id <= 10)
        {
            if (id != 8)
            {
                if (AI_CHK_FRIDBAD(id, 0x00080000) == 1)
                {
                    uid = AI_GET_UNI(0, id);
                    if (uid != -1)
                    {
                        AI_ACT_SKILL(311);
                        AI_TAR_UID(uid);
                        sActionDone = 10;
                        return;
                    }
                }
            }
            id = id + 1;
        }
    }
    else if (AI_CHK_MYABLESKIL(310) == 1)
    {
        if (AI_CHK_FRIDBAD(1, 0x00080000) == 1)
        {
            uid = AI_GET_UNI(0, 1);
            if (uid != -1)
            {
                AI_ACT_SKILL(310);
                AI_TAR_UID(uid);
                sActionDone = 10;
                return;
            }
        }
        id = 2;
        while (id <= 10)
        {
            if (id != 8)
            {
                if (AI_CHK_FRIDBAD(id, 0x00080000) == 1)
                {
                    uid = AI_GET_UNI(0, id);
                    if (uid != -1)
                    {
                        AI_ACT_SKILL(310);
                        AI_TAR_UID(uid);
                        sActionDone = 10;
                        return;
                    }
                }
            }
            id = id + 1;
        }
    }

    res = AI_ACT_REZ();
    if (res != -1)
    {
        sActionDone = 10;
    }
}

// proactive: 0=Act Freely (65% healer / 50% other), 1=Heal/Support (75%), 2=1-More critical-only (40%)
void ACT_Heal(int proactive)
{
    int maxThresh;
    int critThresh;
    int id;
    int uid;
    int maxHp;
    int hpPct;
    int bestPct;
    int worstChar;
    int hurtCount;
    int critCount;
    int hasSingle;
    int hasMulti;
    int hasAilment;
    int res;

    if (sLockMode == 4)
    {
        return;
    }

    hasSingle = 0;
    if ((AI_CHK_MYABLESKIL(300) == 1) || (AI_CHK_MYABLESKIL(301) == 1) || (AI_CHK_MYABLESKIL(302) == 1) || ((sLockMode != 3) && (AI_CHK_MYABLESKIL(183) == 1)))
    {
        hasSingle = 1;
    }

    hasMulti = 0;
    if ((AI_CHK_MYABLESKIL(305) == 1) || (AI_CHK_MYABLESKIL(306) == 1) || (AI_CHK_MYABLESKIL(307) == 1) || ((sLockMode != 7) && (AI_CHK_MYABLESKIL(318) == 1)))
    {
        hasMulti = 1;
    }

    if ((hasSingle == 0) && (hasMulti == 0))
    {
        return;
    }

    if (proactive == 2)
    {
        maxThresh = 40;
        critThresh = 40;
    }
    else if (proactive == 1)
    {
        maxThresh = 75;
        critThresh = 50;
    }
    else if (sIsHealerChar == 1)
    {
        maxThresh = 65;
        critThresh = 40;
    }
    else
    {
        maxThresh = 50;
        critThresh = 30;
    }

    worstChar = 0;
    bestPct = 101;
    hurtCount = 0;
    critCount = 0;
    id = 10;
    while (id >= 1)
    {
        if (IsAllyAlive(id) == 1)
        {
            uid = AI_GET_UNI(0, id);
            if (uid != -1)
            {
                maxHp = AI_GET_P_MAX_HP(uid);
                if (maxHp > 0)
                {
                    hpPct = (100 * AI_GET_P_NOW_HP(uid)) / maxHp;
                    if (hpPct <= maxThresh)
                    {
                        hurtCount = hurtCount + 1;
                        if (hpPct <= critThresh)
                        {
                            critCount = critCount + 1;
                        }
                        if (hpPct <= bestPct)
                        {
                            bestPct = hpPct;
                            worstChar = id;
                        }
                    }
                }
            }
        }
        id = id - 1;
    }

    if (hurtCount == 0)
    {
        return;
    }

    hasAilment = AI_CHK_FRBAD(0x0FFF);

    if ((hurtCount >= 2) && (hasMulti == 1))
    {
        if ((hasAilment == 1) && (sLockMode != 7) && (AI_CHK_MYABLESKIL(318) == 1))
        {
            if ((critCount >= 1) || (sIsBoss == 1) || (AI_CHK_FRBAD(0x0F3E) == 1))
            {
                AI_ACT_SKILL(318);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
        }
