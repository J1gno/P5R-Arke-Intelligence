void ACT_ChargeConcentrate(int aggressive)
{
    int enemyHealthy;
    int canUse;
    int physOk;

    if (sLockMode == 3)
    {
        return;
    }

    enemyHealthy = 0;
    if (((sIsBoss == 1) && (AI_CHK_ENALLHP(15) == 0)) || ((sIsBoss == 0) && (AI_CHK_ENALLHP(50) == 0)))
    {
        enemyHealthy = 1;
    }
    if (enemyHealthy == 0)
    {
        return;
    }

    if (AI_CHK_MORE() == 1)
    {
        return;
    }

    canUse = 0;
    if (sIsBoss == 1)
    {
        canUse = 1;
    }
    else if (aggressive == 1)
    {
        if (RND(100) < 50)
        {
            canUse = 1;
        }
    }
    else if (RND(100) < 30)
    {
        canUse = 1;
    }

    if (canUse == 0)
    {
        return;
    }

    physOk = 1;
    if ((sNotPhysical == 1) || (sLockMode == 1))
    {
        physOk = 0;
    }
    else if ((sEnemyCount == 1) && (IsAttrKnownImmune(0) == 1))
    {
        physOk = 0;
    }

    // 290=Fighting Spirit / 360=Charge (HOJO 0x0100); 294=High Energy / 361=Concentrate (HOJO 0x0200)
    if ((physOk == 1) && (sIsBoss == 1) && (sMySpPct >= 35) && (AI_CHK_MYABLESKIL(290) == 1) && (AI_CHK_NOTMYHOJO(0x0100) == 1))
    {
        if (CountCapableWithoutHojo(0x0100) >= 2)
        {
            AI_ACT_SKILL(290);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
    }

    if ((sLockMode != 2) && (sIsBoss == 1) && (sMySpPct >= 35) && (AI_CHK_MYABLESKIL(294) == 1) && (AI_CHK_NOTMYHOJO(0x0200) == 1))
    {
        if (CountCapableWithoutHojo(0x0200) >= 2)
        {
            AI_ACT_SKILL(294);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
    }

    if ((physOk == 1) && (AI_CHK_MYABLESKIL(360) == 1) && (AI_CHK_NOTMYHOJO(0x0100) == 1))
    {
        if ((sMyHpPct > 40) && ((aggressive == 1) || (sMySpPct >= 20)))
        {
            AI_ACT_SKILL(360);
            AI_TAR_MINE();
            sActionDone = 10;
            return;
        }
    }

    if ((sLockMode != 2) && (AI_CHK_MYABLESKIL(361) == 1) && (AI_CHK_NOTMYHOJO(0x0200) == 1))
    {
        if (((aggressive == 1) && (sMySpPct >= 15)) || (sMySpPct >= 25))
        {
            AI_ACT_SKILL(361);
            AI_TAR_MINE();
            sActionDone = 10;
            return;
        }
    }
}

void ACT_1MoreWeakness(int aggressive)
{
    int attr;
    int uid;
    int singleOnly;
    int skill;
    int res;
    int skipAttr;

    if (sNo1MoreFlag == 1)
    {
        return;
    }

    if ((AI_CHK_FRIDBAD(1, 0x00200000) == 1) || (sDownCount >= sEnemyCount))
    {
        return;
    }

    // Skill 299 (Guiding Tendril): ambush AoE down; AI_CHK_MYUSESKIL(299)==0 + AI_CHK_MORE()==0 prevent repeat loops.
    if ((sLockMode != 2) && (sIsBoss == 0) && (sIsUnstable == 0) && (sSingleOnlyFlag == 0) && (AI_CHK_MORE() == 0) && (((sEnemyCount - sDownCount) >= 2) || ((sIsHouma == 1) && (sDownCount == 0))) && (sMySpPct >= 20) && (AI_CHK_MYHOJO(0x0200) == 0) && (AI_CHK_MYUSESKIL(299) == 0) && (AI_CHK_MYABLESKIL(299) == 1))
    {
        AI_ACT_SKILL(299);
        AI_TAR_RND();
        sActionDone = 10;
        return;
    }

    // Preserve Charge (0x0100) rather than spending it on basic Gun or melee.
    if ((sLockMode != 1) && (AI_CHK_MYHOJO(0x0100) == 0) && (AI_GET_BULLET() > 0))
    {
        uid = AI_GET_UNIWEAK_ST(1);
        if (uid != -1)
        {
            if ((AI_CHK_UNIANALYZE_OPEN(uid, 1) == 1) && (AI_CHK_UNIHOJO(uid, 0x4000) == 0))
            {
                if ((sMyCharId != 4) && (sMyCharId != 7))
                {
                    AI_ACT_GUN();
                    AI_TAR_UID(uid);
                    sActionDone = 10;
                    return;
                }
                else if (IsAoEGunSafe() == 1)
                {
                    AI_ACT_GUN();
                    AI_TAR_UID(uid);
                    sActionDone = 10;
                    return;
                }
            }
        }
    }

    if ((sLockMode != 1) && (sNotPhysical == 0) && (aggressive == 0) && (AI_CHK_MYHOJO(0x0100) == 0))
    {
        res = AI_GET_MYATTRATTACK();
        uid = AI_GET_UNIWEAK_ST(res);
        if (uid != -1)
        {
            if ((AI_CHK_UNIANALYZE_OPEN(uid, res) == 1) && (AI_CHK_UNIBAD(uid, 4) == 0) && (AI_CHK_UNIHOJO(uid, 0x4000) == 0))
            {
                AI_ACT_ATTACK();
                AI_TAR_UID(uid);
                sActionDone = 10;
                return;
            }
        }
    }

    attr = 0;
    while (attr <= 9)
    {
        skipAttr = 0;
        if (((attr == 0) || (attr == 1)) && ((sLockMode == 1) || ((attr == 0) && (sNotPhysical == 1))))
        {
            skipAttr = 1;
        }
        if ((attr >= 2) && (sLockMode == 2))
        {
            skipAttr = 1;
        }
        if (((attr == 0) || (attr == 1)) && (sMyHpPct <= 30))
        {
            skipAttr = 1;
        }

        if (skipAttr == 0)
        {
            uid = AI_GET_UNIWEAK_ST(attr);
            if (uid != -1)
            {
                if ((AI_CHK_UNIANALYZE_OPEN(uid, attr) == 1) && (((attr <= 1) && (AI_CHK_UNIHOJO(uid, 0x4000) == 0)) || ((attr >= 2) && (AI_CHK_UNIHOJO(uid, 0x8000) == 0))))
                {
                    if (IsAoESafeForAttr(attr) == 1)
                    {
                        singleOnly = 0;
                    }
                    else
                    {
                        singleOnly = 1;
                    }

                    skill = AI_GET_UNIBESTATTRSKIL(uid, attr, singleOnly);
                    if ((skill <= 0) && (singleOnly == 1) && (sEnemyCount == 1))
                    {
                        skill = AI_GET_UNIBESTATTRSKIL(uid, attr, 0);
                    }
                    if (skill > 0)
                    {
                        sTargetUid = uid;
                        sSkillId = skill;
                        sActionDone = 1;
                        return;
                    }
                }
            }
        }

        attr = attr + 1;
    }
}

// Baton Pass priority: Weakness -> Technical -> Emergency Heal -> Charged/Joker/DPS
void ACT_Takeover()
{
    int id;
    int critLow;
    int targetUid;
    int targetOrder;

    if (sLockMode == 6)
    {
        return;
    }

    if (AI_CHK_MORE() != 1)
    {
        return;
    }

    id = 2;
    while (id <= 10)
    {
        if (id != 8)
        {
            if (IsAllySkillCapable(id) == 1)
            {
                if ((AI_CHK_TAKEOVER(id) == 1) && (AI_CHK_ABLEWEAK(id) == 1))
                {
                    targetUid = AI_GET_UNI(0, id);
                    if (targetUid != -1)
                    {
                        if (AI_GET_P_ORDER(targetUid) <= 1)
                        {
                            AI_ACT_TAKEOVER(id);
                            sActionDone = 10;
                            return;
                        }
                    }
                }
            }
        }
        id = id + 1;
    }
    if (IsAllySkillCapable(1) == 1)
    {
        if ((AI_CHK_TAKEOVER(1) == 1) && (AI_CHK_ABLEWEAK(1) == 1))
        {
            AI_ACT_TAKEOVER(1);
            sActionDone = 10;
            return;
        }
    }
    id = 2;
    while (id <= 10)
    {
        if (id != 8)
        {
            if (IsAllySkillCapable(id) == 1)
            {
                if ((AI_CHK_TAKEOVER(id) == 1) && (AI_CHK_ABLEWEAK(id) == 1))
                {
                    targetUid = AI_GET_UNI(0, id);
                    if (targetUid != -1)
                    {
                        if (AI_GET_P_ORDER(targetUid) == 3)
                        {
                            AI_ACT_TAKEOVER(id);
                            sActionDone = 10;
                            return;
                        }
                    }
                }
            }
        }
        id = id + 1;
    }

    if (AI_CHK_MYHOJO(0x0300) == 0)
    {
        id = 2;
        while (id <= 10)
        {
            if (id != 8)
            {
                if (IsAllySkillCapable(id) == 1)
                {
                    if ((AI_CHK_TAKEOVER(id) == 1) && (AI_CHK_FRIDTECH(id) == 1))
                    {
                        targetUid = AI_GET_UNI(0, id);
                        if (targetUid != -1)
                        {
                            if ((AI_GET_P_ORDER(targetUid) != 2) && (AI_GET_P_ORDER(targetUid) != 3))
                            {
                                AI_ACT_TAKEOVER(id);
                                sActionDone = 10;
                                return;
                            }
                        }
                    }
                }
            }
            id = id + 1;
        }
        if (IsAllySkillCapable(1) == 1)
        {
            if ((AI_CHK_TAKEOVER(1) == 1) && (AI_CHK_FRIDTECH(1) == 1))
            {
                AI_ACT_TAKEOVER(1);
                sActionDone = 10;
                return;
            }
        }
    }

    if (sLockMode != 4)
    {
        critLow = 0;
        id = 1;
        while ((id <= 10) && (critLow == 0))
        {
            if (IsAllyAlive(id) == 1)
            {
                if (AI_CHK_FRIDHP(id, 40) == 1)
                {
                    critLow = 1;
                }
            }
            id = id + 1;
        }
        if (critLow == 1)
        {
            if (IsAllySkillCapable(3) == 1)
            {
                if ((AI_CHK_TAKEOVER(3) == 1) && (AI_CHK_FRIDHREC(3) == 1))
                {
                    targetUid = AI_GET_UNI(0, 3);
                    if (targetUid != -1)
                    {
                        targetOrder = AI_GET_P_ORDER(targetUid);
                        if ((targetOrder == 0) || (targetOrder == 3))
                        {
                            AI_ACT_TAKEOVER(3);
                            sActionDone = 10;
                            return;
                        }
                    }
                }
            }
            if (IsAllySkillCapable(6) == 1)
            {
                if ((AI_CHK_TAKEOVER(6) == 1) && (AI_CHK_FRIDHREC(6) == 1))
                {
                    targetUid = AI_GET_UNI(0, 6);
                    if (targetUid != -1)
                    {
                        targetOrder = AI_GET_P_ORDER(targetUid);
                        if ((targetOrder == 0) || (targetOrder == 3))
                        {
                            AI_ACT_TAKEOVER(6);
                            sActionDone = 10;
                            return;
                        }
                    }
                }
            }
            if (IsAllySkillCapable(4) == 1)
            {
                if ((AI_CHK_TAKEOVER(4) == 1) && (AI_CHK_FRIDHREC(4) == 1))
                {
                    targetUid = AI_GET_UNI(0, 4);
                    if (targetUid != -1)
                    {
                        targetOrder = AI_GET_P_ORDER(targetUid);
                        if ((targetOrder == 0) || (targetOrder == 3))
                        {
                            AI_ACT_TAKEOVER(4);
                            sActionDone = 10;
                            return;
                        }
                    }
                }
            }
            if (IsAllySkillCapable(10) == 1)
            {
                if ((AI_CHK_TAKEOVER(10) == 1) && (AI_CHK_FRIDHREC(10) == 1))
                {
                    targetUid = AI_GET_UNI(0, 10);
                    if (targetUid != -1)
                    {
                        targetOrder = AI_GET_P_ORDER(targetUid);
                        if ((targetOrder == 0) || (targetOrder == 3))
                        {
                            AI_ACT_TAKEOVER(10);
                            sActionDone = 10;
                            return;
                        }
                    }
                }
            }
            if (IsAllySkillCapable(1) == 1)
            {
                if ((AI_CHK_TAKEOVER(1) == 1) && (AI_CHK_FRIDHREC(1) == 1))
                {
                    AI_ACT_TAKEOVER(1);
                    sActionDone = 10;
                    return;
                }
            }
        }
    }

    // Skip passing if self is Charged/Concentrated (0x0300) so actor unleashes own buff.
    if (AI_CHK_MYHOJO(0x0300) == 0)
    {
        id = 2;
        while (id <= 10)
        {
            if (id != 8)
            {
                if (IsAllySkillCapable(id) == 1)
                {
                    if (AI_CHK_TAKEOVER(id) == 1)
                    {
                        targetUid = AI_GET_UNI(0, id);
                        if (targetUid != -1)
                        {
                            targetOrder = AI_GET_P_ORDER(targetUid);
                            if (targetOrder != 3)
                            {
                                if ((AI_CHK_FRIDHOJO(id, 0x0100) == 1) || ((targetOrder != 2) && (AI_CHK_FRIDHOJO(id, 0x0200) == 1)))
                                {
                                    AI_ACT_TAKEOVER(id);
                                    sActionDone = 10;
                                    return;
                                }
                            }
                        }
                    }
                }
            }
            id = id + 1;
        }

        if (IsAllyCapable(1) == 1)
        {
            if (AI_CHK_TAKEOVER(1) == 1)
            {
                AI_ACT_TAKEOVER(1);
                sActionDone = 10;
                return;
            }
        }

        if ((sOrder == 3) || (sOrder == 2) || (sIsHealerChar == 1))
        {
            if (IsAllySkillCapable(2) == 1)  { if (AI_CHK_TAKEOVER(2) == 1)  { targetUid = AI_GET_UNI(0, 2);  if (targetUid != -1) { if (AI_GET_P_ORDER(targetUid) <= 1) { AI_ACT_TAKEOVER(2);  sActionDone = 10; return; } } } }
            if (IsAllySkillCapable(4) == 1)  { if (AI_CHK_TAKEOVER(4) == 1)  { targetUid = AI_GET_UNI(0, 4);  if (targetUid != -1) { if (AI_GET_P_ORDER(targetUid) <= 1) { AI_ACT_TAKEOVER(4);  sActionDone = 10; return; } } } }
            if (IsAllySkillCapable(5) == 1)  { if (AI_CHK_TAKEOVER(5) == 1)  { targetUid = AI_GET_UNI(0, 5);  if (targetUid != -1) { if (AI_GET_P_ORDER(targetUid) <= 1) { AI_ACT_TAKEOVER(5);  sActionDone = 10; return; } } } }
            if (IsAllySkillCapable(9) == 1)  { if (AI_CHK_TAKEOVER(9) == 1)  { targetUid = AI_GET_UNI(0, 9);  if (targetUid != -1) { if (AI_GET_P_ORDER(targetUid) <= 1) { AI_ACT_TAKEOVER(9);  sActionDone = 10; return; } } } }
            if (IsAllySkillCapable(10) == 1) { if (AI_CHK_TAKEOVER(10) == 1) { targetUid = AI_GET_UNI(0, 10); if (targetUid != -1) { if (AI_GET_P_ORDER(targetUid) <= 1) { AI_ACT_TAKEOVER(10); sActionDone = 10; return; } } } }
            if (IsAllySkillCapable(7) == 1)  { if (AI_CHK_TAKEOVER(7) == 1)  { targetUid = AI_GET_UNI(0, 7);  if (targetUid != -1) { if (AI_GET_P_ORDER(targetUid) <= 1) { AI_ACT_TAKEOVER(7);  sActionDone = 10; return; } } } }
            if (IsAllySkillCapable(6) == 1)  { if (AI_CHK_TAKEOVER(6) == 1)  { targetUid = AI_GET_UNI(0, 6);  if (targetUid != -1) { if (AI_GET_P_ORDER(targetUid) <= 1) { AI_ACT_TAKEOVER(6);  sActionDone = 10; return; } } } }
        }
    }
}

void ACT_Technical()
{
    int res;

    // Skill 297 (Rebellion Blade): bonus Almighty damage on Downed (0x00100000) foes.
    if ((sLockMode != 2) && (AI_CHK_MYABLESKIL(297) == 1) && (AI_CHK_ENBAD(0x00100000) == 1))
    {
        if (((sIsBoss == 1) && ((AI_CHK_MYHOJO(0x0200) == 1) || (sOrder == 1) || (sMySpPct >= 30))) || ((sOrder == 1) && (sMySpPct >= 35) && (AI_CHK_ENALLHP(40) == 0)))
        {
            AI_ACT_SKILL(297);
            AI_TAR_BAD(0x00100000);
            sActionDone = 10;
            return;
        }
    }

    if ((sLockMode == 1) || (sLockMode == 2))
    {
        return;
    }

    // Skip engine AI_ACT_TECHNICAL() while Charged/Concentrated (0x0300) or enemy Karns (0xC000) are active.
    if ((AI_CHK_MYHOJO(0x0300) == 1) || (AI_CHK_ENHOJO(0xC000) == 1))
    {
        return;
    }

    res = AI_ACT_TECHNICAL();
    if (res != -1)
    {
        sActionDone = 10;
    }
}

void ACT_KillEnemy_Gun()
{
    int uid;

    if ((sLockMode == 1) || (sIsBoss == 1) || (AI_CHK_MYHOJO(0x0100) == 1) || (AI_GET_BULLET() <= 0))
    {
        return;
    }

    if ((sMyCharId == 4) || (sMyCharId == 7))
    {
        if (IsAoEGunSafe() == 0)
        {
            return;
        }
    }

    uid = AI_GET_UNIWEAKHPMIN(1);
    if (uid != -1)
    {
        if ((AI_CHK_UNIANALYZE_OPEN(uid, 1) == 1) && (AI_CHK_UNIHP(uid, 35) == 1) && (AI_CHK_UNIHOJO(uid, 0x4000) == 0))
        {
            AI_ACT_GUN();
            AI_TAR_UID(uid);
            sActionDone = 10;
            return;
        }
    }

    uid = AI_GET_UNINOMALHPMIN(1);
    if (uid != -1)
    {
        if ((AI_CHK_UNIHP(uid, 25) == 1) && (AI_CHK_UNIHOJO(uid, 0x4000) == 0))
        {
            AI_ACT_GUN();
            AI_TAR_UID(uid);
            sActionDone = 10;
            return;
        }
    }
}

void ACT_GunWeakOrKill()
{
    int uid;

    if ((sLockMode == 1) || (sNo1MoreFlag == 1) || (AI_CHK_MYHOJO(0x0100) == 1) || (AI_GET_BULLET() <= 0))
    {
        return;
    }

    if ((sMyCharId == 4) || (sMyCharId == 7))
    {
        if (IsAoEGunSafe() == 0)
        {
            return;
        }
    }

    uid = AI_GET_UNIWEAK_ST(1);
    if (uid != -1)
    {
        if ((AI_CHK_UNIANALYZE_OPEN(uid, 1) == 1) && (AI_CHK_UNIHOJO(uid, 0x4000) == 0))
        {
            AI_ACT_GUN();
            AI_TAR_UID(uid);
            sActionDone = 10;
            return;
        }
    }

    ACT_KillEnemy_Gun();
}

void ACT_GunSmart()
{
    int uid;

    if ((sLockMode == 1) || (sNo1MoreFlag == 1) || (AI_CHK_MYHOJO(0x0100) == 1) || (AI_GET_BULLET() <= 0))
    {
        return;
    }

    if ((sMyCharId == 4) || (sMyCharId == 7))
    {
        if (IsAoEGunSafe() == 0)
        {
            return;
        }
    }

    uid = AI_GET_UNIWEAK_ST(1);
    if (uid != -1)
    {
        if ((AI_CHK_UNIANALYZE_OPEN(uid, 1) == 1) && (AI_CHK_UNIHOJO(uid, 0x4000) == 0))
        {
            AI_ACT_GUN();
            AI_TAR_UID(uid);
            sActionDone = 10;
            return;
        }
    }

    uid = AI_GET_UNIWEAK(1);
    if (uid != -1)
    {
        if ((AI_CHK_UNIANALYZE_OPEN(uid, 1) == 1) && (AI_CHK_UNIHOJO(uid, 0x4000) == 0))
        {
            AI_ACT_GUN();
            AI_TAR_UID(uid);
            sActionDone = 10;
            return;
        }
    }

    if (sIsUnstable == 1)
    {
        return;
    }

    // Freeze (0x02) Technical
    if ((AI_CHK_ENBAD(0x02) == 1) && (AI_CHK_ENHOJO(0x4000) == 0))
    {
        AI_ACT_GUN();
        AI_TAR_BAD(0x02);
        sActionDone = 10;
        return;
    }

    uid = AI_GET_UNINOMALHPMIN(1);
    if (uid != -1)
    {
        if (AI_CHK_UNIHOJO(uid, 0x4000) == 0)
        {
            AI_ACT_GUN();
            AI_TAR_UID(uid);
            sActionDone = 10;
            return;
        }
    }

    uid = AI_GET_UNI_NOANALYZE(1);
    if (uid != -1)
    {
        if (AI_CHK_UNIHOJO(uid, 0x4000) == 0)
        {
            AI_ACT_GUN();
            AI_TAR_UID(uid);
            sActionDone = 10;
            return;
        }
    }
}

void ACT_UrgentDispel()
{
    if (sLockMode == 3)
    {
        return;
    }

    if ((sIsBoss == 0) && ((AI_CHK_ENALLHP(25) == 1) || (sMySpPct < 15)))
    {
        return;
    }

    // 356=Dekaja; 0x55 = AtkUp(0x01)|EvaUp(0x04)|DefUp(0x10)|AccUp(0x40)
    if (AI_CHK_MYABLESKIL(356) == 1)
    {
        if (AI_CHK_ENHOJO(0x55) == 1)
        {
            AI_ACT_SKILL(356);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
    }

    // 355=Dekunda; 0xAA = AtkDown(0x02)|EvaDown(0x08)|DefDown(0x20)|AccDown(0x80)
    if (AI_CHK_MYABLESKIL(355) == 1)
    {
        if (AI_CHK_FRHOJO(0xAA) == 1)
        {
            AI_ACT_SKILL(355);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
    }

    if (AI_CHK_MYABLESKIL(375) == 1)
    {
        if (AI_CHK_ENHOJO(0x4000) == 1)
        {
            AI_ACT_SKILL(375);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
    }
    if (AI_CHK_MYABLESKIL(376) == 1)
    {
        if (AI_CHK_ENHOJO(0x8000) == 1)
        {
            AI_ACT_SKILL(376);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
    }
}

int PickConcentrateAlly()
{
    int uid;
    if (IsAllySkillCapable(1) == 1) { if (AI_CHK_FRIDHOJO(1, 0x0200) == 0) { return 1; } }
    if (IsAllySkillCapable(4) == 1) { uid = AI_GET_UNI(0, 4); if (uid != -1) { if ((AI_GET_P_ORDER(uid) <= 1) && (AI_CHK_FRIDHOJO(4, 0x0200) == 0)) { return 4; } } }
    if (IsAllySkillCapable(6) == 1) { uid = AI_GET_UNI(0, 6); if (uid != -1) { if ((AI_GET_P_ORDER(uid) <= 1) && (AI_CHK_FRIDHOJO(6, 0x0200) == 0)) { return 6; } } }
    if (IsAllySkillCapable(7) == 1) { uid = AI_GET_UNI(0, 7); if (uid != -1) { if ((AI_GET_P_ORDER(uid) <= 1) && (AI_CHK_FRIDHOJO(7, 0x0200) == 0)) { return 7; } } }
    if (IsAllySkillCapable(9) == 1) { uid = AI_GET_UNI(0, 9); if (uid != -1) { if ((AI_GET_P_ORDER(uid) <= 1) && (AI_CHK_FRIDHOJO(9, 0x0200) == 0)) { return 9; } } }
    if (IsAllySkillCapable(3) == 1) { uid = AI_GET_UNI(0, 3); if (uid != -1) { if ((AI_GET_P_ORDER(uid) <= 1) && (AI_CHK_FRIDHOJO(3, 0x0200) == 0)) { return 3; } } }
    return 0;
}

int PickChargeAlly()
{
    int uid;
    if (IsAllySkillCapable(1) == 1)  { if (AI_CHK_FRIDHOJO(1, 0x0100) == 0)  { return 1; } }
    if (IsAllySkillCapable(2) == 1)  { uid = AI_GET_UNI(0, 2);  if (uid != -1) { if ((AI_GET_P_ORDER(uid) != 3) && (AI_CHK_FRIDHP(2, 35) == 0)  && (AI_CHK_FRIDHOJO(2, 0x0100) == 0))  { return 2; } } }
    if (IsAllySkillCapable(10) == 1) { uid = AI_GET_UNI(0, 10); if (uid != -1) { if ((AI_GET_P_ORDER(uid) != 3) && (AI_CHK_FRIDHP(10, 35) == 0) && (AI_CHK_FRIDHOJO(10, 0x0100) == 0)) { return 10; } } }
    if (IsAllySkillCapable(5) == 1)  { uid = AI_GET_UNI(0, 5);  if (uid != -1) { if ((AI_GET_P_ORDER(uid) != 3) && (AI_CHK_FRIDHP(5, 35) == 0)  && (AI_CHK_FRIDHOJO(5, 0x0100) == 0))  { return 5; } } }
    if (IsAllySkillCapable(9) == 1)  { uid = AI_GET_UNI(0, 9);  if (uid != -1) { if ((AI_GET_P_ORDER(uid) != 3) && (AI_CHK_FRIDHP(9, 35) == 0)  && (AI_CHK_FRIDHOJO(9, 0x0100) == 0))  { return 9; } } }
    if (IsAllySkillCapable(7) == 1)  { uid = AI_GET_UNI(0, 7);  if (uid != -1) { if ((AI_GET_P_ORDER(uid) != 3) && (AI_CHK_FRIDHP(7, 35) == 0)  && (AI_CHK_FRIDHOJO(7, 0x0100) == 0))  { return 7; } } }
    return 0;
}

// HOJO2 bit 2 = Bleeding Dry Brush (184) Universal Drain barrier
int PickDrainBarrierAlly()
{
    int id;
    if (IsAllyAlive(1) == 1)
    {
        if (AI_CHK_FRIDHOJO2(1, 2) == 0)
        {
            return 1;
        }
    }
    id = 2;
    while (id <= 10)
    {
        if (id != 8)
        {
            if (IsAllyAlive(id) == 1)
            {
                if (AI_CHK_FRIDHOJO2(id, 2) == 0)
                {
                    return id;
                }
            }
        }
        id = id + 1;
    }
    return 0;
}

int PickAllyWithoutHojo(int mask)
{
    int id;
    if (IsAllyAlive(1) == 1)
    {
        if (AI_CHK_FRIDHOJO(1, mask) == 0)
        {
            return 1;
        }
    }
    id = 2;
    while (id <= 10)
    {
        if (id != 8)
        {
            if (IsAllyAlive(id) == 1)
            {
                if (AI_CHK_FRIDHOJO(id, mask) == 0)
                {
                    return id;
                }
            }
        }
        id = id + 1;
    }
    return 0;
}

// guaranteed = 1 in Heal/Support (enables party Charge/Concentrate and secondary-ally shields)
void ACT_Support(int guaranteed)
{
    int allyId;
    int res;

    if (sLockMode == 3)
    {
        return;
    }

    if ((sIsBoss == 1) && (sMySpPct >= 30) && (AI_CHK_MYABLESKIL(292) == 1))
    {
        if ((sEnemyCount >= 2) || (AI_CHK_MYABLESKIL(348) == 0))
        {
            if (((AI_CHK_NOTENHOJO(0x20) == 1) && (AI_CHK_NOTENHOJO(0x02) == 1)) || ((AI_CHK_NOTENHOJO(0x20) == 1) && (AI_CHK_NOTENHOJO(0x08) == 1)) || ((AI_CHK_NOTENHOJO(0x02) == 1) && (AI_CHK_NOTENHOJO(0x08) == 1)))
            {
                AI_ACT_SKILL(292);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
        }
    }

    if (AI_CHK_MYABLESKIL(348) == 1)
    {
        if ((sIsBoss == 1) || ((AI_CHK_ENALLHP(50) == 0) && (sMySpPct >= 40)))
        {
            if ((AI_CHK_NOTENHOJO(0x20) == 1) && (AI_CHK_NOTENHOJO(0x02) == 1))
            {
                AI_ACT_SKILL(348);
                AI_TAR_NOTHOJO(0x20);
                sActionDone = 10;
                return;
            }
        }
    }

    if (AI_CHK_NOTENHOJO(0x20) == 1)
    {
        if ((AI_CHK_MYABLESKIL(351) == 1) && (sEnemyCount >= 2))
        {
            AI_ACT_SKILL(351);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
        if (AI_CHK_MYABLESKIL(346) == 1)
        {
            AI_ACT_SKILL(346);
            AI_TAR_NOTHOJO(0x20);
            sActionDone = 10;
            return;
        }
        if (AI_CHK_MYABLESKIL(351) == 1)
        {
            AI_ACT_SKILL(351);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
    }

    if (AI_CHK_NOTENHOJO(0x02) == 1)
    {
        if ((AI_CHK_MYABLESKIL(350) == 1) && (sEnemyCount >= 2))
        {
            AI_ACT_SKILL(350);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
        if (AI_CHK_MYABLESKIL(345) == 1)
        {
            AI_ACT_SKILL(345);
            AI_TAR_NOTHOJO(0x02);
            sActionDone = 10;
            return;
        }
        if (AI_CHK_MYABLESKIL(350) == 1)
        {
            AI_ACT_SKILL(350);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
    }

    if (AI_CHK_NOTENHOJO(0x08) == 1)
    {
        if ((AI_CHK_MYABLESKIL(352) == 1) && (sEnemyCount >= 2))
        {
            AI_ACT_SKILL(352);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
        if (AI_CHK_MYABLESKIL(347) == 1)
        {
            AI_ACT_SKILL(347);
            AI_TAR_NOTHOJO(0x08);
            sActionDone = 10;
            return;
        }
        if (AI_CHK_MYABLESKIL(352) == 1)
        {
            AI_ACT_SKILL(352);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
    }

    if ((AI_CHK_MYABLESKIL(293) == 1) || (AI_CHK_MYABLESKIL(343) == 1))
    {
        if ((sIsBoss == 1) && (sMySpPct >= 30) && (AI_CHK_MYABLESKIL(293) == 1))
        {
            res = 0;
            if (PickAllyWithoutHojo(0x01) != 0) { res = res + 1; }
            if (PickAllyWithoutHojo(0x10) != 0) { res = res + 1; }
            if (PickAllyWithoutHojo(0x04) != 0) { res = res + 1; }
            if (res >= 2)
            {
                AI_ACT_SKILL(293);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
        }
        if (AI_CHK_MYABLESKIL(343) == 1)
        {
            allyId = PickAllyWithoutHojo(0x01);
            if (allyId == 0) { allyId = PickAllyWithoutHojo(0x10); }
            if (allyId == 0) { allyId = PickAllyWithoutHojo(0x04); }
            if (allyId != 0)
            {
                AI_ACT_SKILL(343);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
        }
    }

    if ((AI_CHK_MYABLESKIL(340) == 1) || (AI_CHK_MYABLESKIL(335) == 1))
    {
        allyId = PickAllyWithoutHojo(0x01);
        if (allyId != 0)
        {
            if (AI_CHK_MYABLESKIL(340) == 1)
            {
                AI_ACT_SKILL(340);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
            if ((AI_CHK_MYABLESKIL(335) == 1) && (AI_GET_FRHOJO_ON(0x01) < 2) && ((sIsBoss == 1) || ((allyId == 1) && (sMySpPct >= 30) && (AI_CHK_ENALLHP(40) == 0))))
            {
                AI_ACT_SKILL(335);
                AI_TAR_UID(AI_GET_UNI(0, allyId));
                sActionDone = 10;
                return;
            }
        }
    }

    if ((AI_CHK_MYABLESKIL(185) == 1) || (AI_CHK_MYABLESKIL(341) == 1) || (AI_CHK_MYABLESKIL(336) == 1))
    {
        allyId = PickAllyWithoutHojo(0x10);
        if (allyId != 0)
        {
            if (AI_CHK_MYABLESKIL(185) == 1)
            {
                AI_ACT_SKILL(185);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
            if (AI_CHK_MYABLESKIL(341) == 1)
            {
                AI_ACT_SKILL(341);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
            if ((AI_CHK_MYABLESKIL(336) == 1) && (AI_GET_FRHOJO_ON(0x10) < 2) && ((sIsBoss == 1) || ((allyId == 1) && (sMySpPct >= 30) && (AI_CHK_ENALLHP(40) == 0))))
            {
                AI_ACT_SKILL(336);
                AI_TAR_UID(AI_GET_UNI(0, allyId));
                sActionDone = 10;
                return;
            }
        }
    }

    if ((AI_CHK_MYABLESKIL(188) == 1) || (AI_CHK_MYABLESKIL(342) == 1) || (AI_CHK_MYABLESKIL(337) == 1))
    {
        allyId = PickAllyWithoutHojo(0x04);
        if (allyId != 0)
        {
            if (AI_CHK_MYABLESKIL(188) == 1)
            {
                AI_ACT_SKILL(188);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
            if (AI_CHK_MYABLESKIL(342) == 1)
            {
                AI_ACT_SKILL(342);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
            if ((AI_CHK_MYABLESKIL(337) == 1) && (AI_GET_FRHOJO_ON(0x04) < 2) && ((sIsBoss == 1) || ((allyId == 1) && (sMySpPct >= 30) && (AI_CHK_ENALLHP(40) == 0))))
            {
                AI_ACT_SKILL(337);
                AI_TAR_UID(AI_GET_UNI(0, allyId));
                sActionDone = 10;
                return;
            }
        }
    }

    if (AI_CHK_MYABLESKIL(338) == 1)
    {
        if ((sIsBoss == 1) || ((AI_CHK_ENALLHP(50) == 0) && (sMySpPct >= 45)))
        {
            allyId = 0;
            if ((IsAllyAlive(1) == 1) && ((AI_CHK_FRIDHOJO(1, 0x01) == 0) || (AI_CHK_FRIDHOJO(1, 0x10) == 0)))
            {
                allyId = 1;
            }
            else if ((AI_CHK_NOTMYHOJO(0x01) == 1) || (AI_CHK_NOTMYHOJO(0x10) == 1))
            {
                allyId = sMyCharId;
            }
            if (allyId != 0)
            {
                AI_ACT_SKILL(338);
                AI_TAR_UID(AI_GET_UNI(0, allyId));
                sActionDone = 10;
                return;
            }
        }
    }

    if ((guaranteed == 1) && (sIsBoss == 1) && (sMySpPct >= 35) && (AI_CHK_MORE() == 0))
    {
        if ((sNotPhysical == 0) && (sLockMode != 1) && (AI_CHK_MYABLESKIL(290) == 1))
        {
            if ((sEnemyCount > 1) || (IsAttrKnownImmune(0) == 0))
            {
                if (CountCapableWithoutHojo(0x0100) >= 2)
                {
                    AI_ACT_SKILL(290);
                    AI_TAR_RND();
                    sActionDone = 10;
                    return;
                }
            }
        }
        if ((sLockMode != 2) && (AI_CHK_MYABLESKIL(294) == 1))
        {
            if (CountCapableWithoutHojo(0x0200) >= 2)
            {
                AI_ACT_SKILL(294);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
        }
    }

    // Crit buffs: Brave Step (303, 0x1000), Revolution (366, 0x2000), Rebellion (365, 0x1000)
    if (AI_CHK_MYABLESKIL(303) == 1)
    {
        if ((sIsBoss == 1) || ((AI_CHK_ENALLHP(40) == 0) && (sMySpPct >= 30)))
        {
            allyId = PickAllyWithoutHojo(0x1000);
            if (allyId != 0)
            {
                if (PickAllyWithoutHojo(0x2000) != 0)
                {
                    AI_ACT_SKILL(303);
                    AI_TAR_RND();
                    sActionDone = 10;
                    return;
                }
            }
        }
    }
    // Revolution (366) affects enemies too (SKILL.TBL validTargets=0x03) - skip on bosses.
    if ((sIsBoss == 0) && (AI_CHK_MYABLESKIL(366) == 1))
    {
        if ((AI_CHK_ENALLHP(40) == 0) && (sMySpPct >= 25))
        {
            if (PickAllyWithoutHojo(0x2000) != 0)
            {
                AI_ACT_SKILL(366);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
        }
    }
    if ((AI_CHK_MYABLESKIL(365) == 1) && (AI_GET_FRHOJO_ON(0x1000) < 2))
    {
        if ((sIsBoss == 1) || ((AI_CHK_ENALLHP(40) == 0) && (sMySpPct >= 30)))
        {
            allyId = 0;
            if (IsAllyCapable(1) == 1)  { if (AI_CHK_FRIDHOJO(1, 0x3000) == 0)  { allyId = 1; } }
            if ((allyId == 0) && (sIsBoss == 1))
            {
                if (IsAllyCapable(10) == 1) { if (AI_CHK_FRIDHOJO(10, 0x3000) == 0) { allyId = 10; } }
                if ((allyId == 0) && (IsAllyCapable(2) == 1)) { if (AI_CHK_FRIDHOJO(2, 0x3000) == 0) { allyId = 2; } }
                if ((allyId == 0) && (IsAllyCapable(5) == 1)) { if (AI_CHK_FRIDHOJO(5, 0x3000) == 0) { allyId = 5; } }
                if ((allyId == 0) && (IsAllyCapable(3) == 1)) { if (AI_CHK_FRIDHOJO(3, 0x3000) == 0) { allyId = 3; } }
                if ((allyId == 0) && (IsAllyCapable(9) == 1)) { if (AI_CHK_FRIDHOJO(9, 0x3000) == 0) { allyId = 9; } }
                if ((allyId == 0) && (IsAllyCapable(7) == 1)) { if (AI_CHK_FRIDHOJO(7, 0x3000) == 0) { allyId = 7; } }
            }
            if (allyId != 0)
            {
                AI_ACT_SKILL(365);
                AI_TAR_UID(AI_GET_UNI(0, allyId));
                sActionDone = 10;
                return;
            }
        }
    }

    // Skip Karn/drain shields (296/184/370/371) vs Enemy ID 190 (triggers infinite repel-punish Megidolaon loop); 372=Tetraja (0x02000000).
    if ((sIsBoss == 1) && (sMySpPct >= 30) && (AI_CHK_MYABLESKIL(296) == 1))
    {
        if ((AI_CHK_ENID(190) == 0) && (AI_CHK_FRHOJO(0xC000) == 0))
        {
            AI_ACT_SKILL(296);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
    }
    if (AI_CHK_MYABLESKIL(184) == 1)
    {
        if ((AI_CHK_ENID(190) == 0) && (((sIsBoss == 1) && (sMySpPct >= 30)) || ((AI_CHK_ENALLHP(50) == 0) && (sMySpPct >= 50))))
        {
            allyId = 0;
            if ((IsAllyAlive(1) == 1) && (AI_CHK_FRIDHOJO2(1, 2) == 0))
            {
                allyId = 1;
            }
            else if ((sIsBoss == 1) && (guaranteed == 1) && (sMySpPct >= 50))
            {
                allyId = PickDrainBarrierAlly();
            }
            if (allyId != 0)
            {
                AI_ACT_SKILL(184);
                AI_TAR_UID(AI_GET_UNI(0, allyId));
                sActionDone = 10;
                return;
            }
        }
    }
    if ((AI_CHK_MYABLESKIL(370) == 1) || (AI_CHK_MYABLESKIL(371) == 1))
    {
        if ((AI_CHK_ENID(190) == 0) && (((sIsBoss == 1) && (sMySpPct >= 35)) || ((AI_CHK_ENALLHP(50) == 0) && (sMySpPct >= 50))))
        {
            if (AI_CHK_MYABLESKIL(370) == 1)
            {
                allyId = 0;
                if ((IsAllyAlive(1) == 1) && (AI_CHK_FRIDHOJO(1, 0x4000) == 0))
                {
                    allyId = 1;
                }
                else if ((sIsBoss == 1) && (guaranteed == 1) && (sMySpPct >= 50))
                {
                    allyId = PickAllyWithoutHojo(0x4000);
                }
                if (allyId != 0)
                {
                    AI_ACT_SKILL(370);
                    AI_TAR_UID(AI_GET_UNI(0, allyId));
                    sActionDone = 10;
                    return;
                }
            }
            if (AI_CHK_MYABLESKIL(371) == 1)
            {
                allyId = 0;
                if ((IsAllyAlive(1) == 1) && (AI_CHK_FRIDHOJO(1, 0x8000) == 0))
                {
                    allyId = 1;
                }
                else if ((sIsBoss == 1) && (guaranteed == 1) && (sMySpPct >= 50))
                {
                    allyId = PickAllyWithoutHojo(0x8000);
                }
                if (allyId != 0)
                {
                    AI_ACT_SKILL(371);
                    AI_TAR_UID(AI_GET_UNI(0, allyId));
                    sActionDone = 10;
                    return;
                }
            }
        }
    }
    if (AI_CHK_MYABLESKIL(372) == 1)
    {
        if (((sIsBoss == 1) && ((guaranteed == 1) || (sMySpPct >= 25))) || ((AI_CHK_ENALLHP(50) == 0) && (sMySpPct >= 45)))
        {
            if (PickAllyWithoutHojo(0x02000000) != 0)
            {
                AI_ACT_SKILL(372);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
        }
    }

    // Break HOJO bits (SKILL.TBL): Fire(385)=0x01, Ice(386)=0x02, Wind(387)=0x04, Elec(388)=0x08, Nuke(395)=0x10, Psy(396)=0x20 (<< 16)
    if ((sIsBoss == 1) || ((sEnemyCount == 1) && (AI_CHK_ENALLHP(50) == 0)))
    {
        if (AI_CHK_MYABLESKIL(385) == 1)
        {
            if ((AI_CHK_NOTENHOJO(0x00010000) == 1) && (IsAttrKnownImpeded(2) == 1))
            {
                AI_ACT_SKILL(385);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
        }
        if (AI_CHK_MYABLESKIL(386) == 1)
        {
            if ((AI_CHK_NOTENHOJO(0x00020000) == 1) && (IsAttrKnownImpeded(3) == 1))
            {
                AI_ACT_SKILL(386);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
        }
        if (AI_CHK_MYABLESKIL(388) == 1)
        {
            if ((AI_CHK_NOTENHOJO(0x00080000) == 1) && (IsAttrKnownImpeded(4) == 1))
            {
                AI_ACT_SKILL(388);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
        }
        if (AI_CHK_MYABLESKIL(387) == 1)
        {
            if ((AI_CHK_NOTENHOJO(0x00040000) == 1) && (IsAttrKnownImpeded(5) == 1))
            {
                AI_ACT_SKILL(387);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
        }
        if (AI_CHK_MYABLESKIL(396) == 1)
        {
            if ((AI_CHK_NOTENHOJO(0x00200000) == 1) && (IsAttrKnownImpeded(6) == 1))
            {
                AI_ACT_SKILL(396);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
        }
        if (AI_CHK_MYABLESKIL(395) == 1)
        {
            if ((AI_CHK_NOTENHOJO(0x00100000) == 1) && (IsAttrKnownImpeded(7) == 1))
            {
                AI_ACT_SKILL(395);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
        }
    }

    if (((sIsBoss == 1) && (AI_CHK_ENALLHP(15) == 0)) || ((AI_CHK_ENALLHP(50) == 0) && (sMySpPct >= 30)))
    {
        if ((sLockMode != 2) && (AI_CHK_MYABLESKIL(187) == 1))
        {
            allyId = PickConcentrateAlly();
            if (allyId != 0)
            {
                AI_ACT_SKILL(187);
                AI_TAR_UID(AI_GET_UNI(0, allyId));
                sActionDone = 10;
                return;
            }
        }
        if ((sNotPhysical == 0) && (sLockMode != 1) && ((sEnemyCount > 1) || (IsAttrKnownImmune(0) == 0)) && (AI_CHK_MYABLESKIL(189) == 1))
        {
            allyId = PickChargeAlly();
            if (allyId != 0)
            {
                AI_ACT_SKILL(189);
                AI_TAR_UID(AI_GET_UNI(0, allyId));
                sActionDone = 10;
                return;
            }
        }
    }

    if ((sIsBoss == 1) && (AI_CHK_MYABLESKIL(348) == 1))
    {
        if (AI_CHK_NOTENHOJO(0x20) == 1)
        {
            AI_ACT_SKILL(348);
            AI_TAR_NOTHOJO(0x20);
            sActionDone = 10;
            return;
        }
        if (AI_CHK_NOTENHOJO(0x02) == 1)
        {
            AI_ACT_SKILL(348);
            AI_TAR_NOTHOJO(0x02);
            sActionDone = 10;
            return;
        }
        if (AI_CHK_NOTENHOJO(0x08) == 1)
        {
            AI_ACT_SKILL(348);
            AI_TAR_NOTHOJO(0x08);
            sActionDone = 10;
            return;
        }
    }
}

// Two-pass uniform random selector (no arrays in FlowScript): Pass 1 (numAvail) and Pass 2 (chosen) must stay identical.
void ACT_SupportRefresh()
{
    int numAvail;
    int pick;
    int idx;
    int chosen;
    int jokerUid;

    if (sLockMode == 3)
    {
        return;
    }

    if (sIsBoss == 0)
    {
        if ((AI_CHK_ENALLHP(40) == 1) || (sMySpPct < 40) || (RND(100) >= 35))
        {
            return;
        }
    }
    else
    {
        if ((sMySpPct < 30) || (RND(100) >= 35))
        {
            return;
        }
    }

    numAvail = 0;
    if (AI_CHK_MYABLESKIL(348) == 1) { numAvail = numAvail + 1; }
    if (AI_CHK_MYABLESKIL(338) == 1) { numAvail = numAvail + 1; }
    if (AI_CHK_MYABLESKIL(340) == 1) { numAvail = numAvail + 1; }
    else if (AI_CHK_MYABLESKIL(335) == 1) { numAvail = numAvail + 1; }
    if (AI_CHK_MYABLESKIL(185) == 1) { numAvail = numAvail + 1; }
    else if (AI_CHK_MYABLESKIL(341) == 1) { numAvail = numAvail + 1; }
    else if (AI_CHK_MYABLESKIL(336) == 1) { numAvail = numAvail + 1; }
    if (AI_CHK_MYABLESKIL(188) == 1) { numAvail = numAvail + 1; }
    else if (AI_CHK_MYABLESKIL(342) == 1) { numAvail = numAvail + 1; }
    else if (AI_CHK_MYABLESKIL(337) == 1) { numAvail = numAvail + 1; }
    if (sEnemyCount >= 2)
    {
        if (AI_CHK_MYABLESKIL(350) == 1) { numAvail = numAvail + 1; }
        else if (AI_CHK_MYABLESKIL(345) == 1) { numAvail = numAvail + 1; }
        if (AI_CHK_MYABLESKIL(351) == 1) { numAvail = numAvail + 1; }
        else if (AI_CHK_MYABLESKIL(346) == 1) { numAvail = numAvail + 1; }
        if (AI_CHK_MYABLESKIL(352) == 1) { numAvail = numAvail + 1; }
        else if (AI_CHK_MYABLESKIL(347) == 1) { numAvail = numAvail + 1; }
    }
    else
    {
        if (AI_CHK_MYABLESKIL(345) == 1) { numAvail = numAvail + 1; }
        else if (AI_CHK_MYABLESKIL(350) == 1) { numAvail = numAvail + 1; }
        if (AI_CHK_MYABLESKIL(346) == 1) { numAvail = numAvail + 1; }
        else if (AI_CHK_MYABLESKIL(351) == 1) { numAvail = numAvail + 1; }
        if (AI_CHK_MYABLESKIL(347) == 1) { numAvail = numAvail + 1; }
        else if (AI_CHK_MYABLESKIL(352) == 1) { numAvail = numAvail + 1; }
    }
    if (AI_CHK_MYABLESKIL(303) == 1) { numAvail = numAvail + 1; }

    if (numAvail == 0)
    {
        return;
    }

    if (numAvail <= 1)
    {
        pick = 0;
    }
    else
    {
        pick = RND(numAvail - 1);
        if (pick >= numAvail)
        {
            pick = numAvail - 1;
        }
    }

    idx = 0;
    chosen = 0;
    if (AI_CHK_MYABLESKIL(348) == 1) { if (idx == pick) { chosen = 348; } idx = idx + 1; }
    if (AI_CHK_MYABLESKIL(338) == 1) { if (idx == pick) { chosen = 338; } idx = idx + 1; }
    if (AI_CHK_MYABLESKIL(340) == 1) { if (idx == pick) { chosen = 340; } idx = idx + 1; }
    else if (AI_CHK_MYABLESKIL(335) == 1) { if (idx == pick) { chosen = 335; } idx = idx + 1; }
    if (AI_CHK_MYABLESKIL(185) == 1) { if (idx == pick) { chosen = 185; } idx = idx + 1; }
    else if (AI_CHK_MYABLESKIL(341) == 1) { if (idx == pick) { chosen = 341; } idx = idx + 1; }
    else if (AI_CHK_MYABLESKIL(336) == 1) { if (idx == pick) { chosen = 336; } idx = idx + 1; }
    if (AI_CHK_MYABLESKIL(188) == 1) { if (idx == pick) { chosen = 188; } idx = idx + 1; }
    else if (AI_CHK_MYABLESKIL(342) == 1) { if (idx == pick) { chosen = 342; } idx = idx + 1; }
    else if (AI_CHK_MYABLESKIL(337) == 1) { if (idx == pick) { chosen = 337; } idx = idx + 1; }
    if (sEnemyCount >= 2)
    {
        if (AI_CHK_MYABLESKIL(350) == 1) { if (idx == pick) { chosen = 350; } idx = idx + 1; }
        else if (AI_CHK_MYABLESKIL(345) == 1) { if (idx == pick) { chosen = 345; } idx = idx + 1; }
        if (AI_CHK_MYABLESKIL(351) == 1) { if (idx == pick) { chosen = 351; } idx = idx + 1; }
        else if (AI_CHK_MYABLESKIL(346) == 1) { if (idx == pick) { chosen = 346; } idx = idx + 1; }
        if (AI_CHK_MYABLESKIL(352) == 1) { if (idx == pick) { chosen = 352; } idx = idx + 1; }
        else if (AI_CHK_MYABLESKIL(347) == 1) { if (idx == pick) { chosen = 347; } idx = idx + 1; }
    }
    else
    {
        if (AI_CHK_MYABLESKIL(345) == 1) { if (idx == pick) { chosen = 345; } idx = idx + 1; }
        else if (AI_CHK_MYABLESKIL(350) == 1) { if (idx == pick) { chosen = 350; } idx = idx + 1; }
        if (AI_CHK_MYABLESKIL(346) == 1) { if (idx == pick) { chosen = 346; } idx = idx + 1; }
        else if (AI_CHK_MYABLESKIL(351) == 1) { if (idx == pick) { chosen = 351; } idx = idx + 1; }
        if (AI_CHK_MYABLESKIL(347) == 1) { if (idx == pick) { chosen = 347; } idx = idx + 1; }
        else if (AI_CHK_MYABLESKIL(352) == 1) { if (idx == pick) { chosen = 352; } idx = idx + 1; }
    }
    if (AI_CHK_MYABLESKIL(303) == 1) { if (idx == pick) { chosen = 303; } idx = idx + 1; }

    if (chosen > 0)
    {
        AI_ACT_SKILL(chosen);
        if ((chosen == 348) || (chosen == 345) || (chosen == 346) || (chosen == 347))
        {
            AI_TAR_HPMAX();
        }
        else if ((chosen == 338) || (chosen == 335) || (chosen == 336) || (chosen == 337))
        {
            jokerUid = AI_GET_UNI(0, 1);
            if ((IsAllyAlive(1) == 1) && (jokerUid != -1))
            {
                AI_TAR_UID(jokerUid);
            }
            else
            {
                AI_TAR_RND();
            }
        }
        else
        {
            AI_TAR_RND();
        }
        sActionDone = 10;
    }
}

void ACT_Ailment(int forced)
{
    int res;

    if (sLockMode == 2)
    {
        return;
    }

    // Makarakarn (0x8000) reflects magic ailments.
    if ((forced == 0) && ((AI_CHK_ENALLHP(30) == 1) || (sMySpPct < 20) || (AI_CHK_ENHOJO(0x8000) == 1)))
    {
        return;
    }

    res = AI_ACT_BADSKILL();
    if (res != -1)
    {
        sActionDone = 10;
    }
}

void ACT_UnknownAttr()
{
    int res;

    if ((sLockMode == 1) || (sLockMode == 2) || (sNo1MoreFlag == 1) || (sIsUnstable == 1))
    {
        return;
    }

    if ((AI_CHK_MYHOJO(0x0300) == 1) || (AI_CHK_ENHOJO(0xC000) == 1))
    {
        return;
    }

    res = AI_ACT_UNKNOWN_ATTR(0);
    if (res != -1)
    {
        sActionDone = 10;
    }
}

void ACT_Fixed()
{
    int res;

    if (BIT_CHK(805306368 + 370) == 1)
    {
        return;
    }

    res = AI_ACT_FIXED();
    if (res != -1)
    {
        sActionDone = 10;
    }
}

// minHeavyHp: HP% floor for heavy single-target Phys skills (298, 279); preferHighHp: 1 targets highest-HP foe instead of lowest.
void TrySignaturePhysSkills(int allowAoE, int minHeavyHp, int preferHighHp)
{
    int uid;

    if ((sNotPhysical == 1) || (sLockMode == 1))
    {
        return;
    }

    if ((sMyHpPct > minHeavyHp) && (AI_CHK_MYABLESKIL(298) == 1))
    {
        uid = AI_GET_UNIWEAK(0);
        if (uid != -1)
        {
            if (AI_CHK_UNIANALYZE_OPEN(uid, 0) == 0)
            {
                uid = -1;
            }
        }
        if (uid == -1)
        {
            if (preferHighHp == 1)
            {
                uid = AI_GET_UNINOMALLVMAXHPMAX(0);
            }
            if (uid == -1)
            {
                uid = AI_GET_UNINOMALHPMIN(0);
            }
        }
        if (uid != -1)
        {
            if (AI_CHK_UNIHOJO(uid, 0x4000) == 0)
            {
                AI_ACT_SKILL(298);
                AI_TAR_UID(uid);
                sActionDone = 10;
                return;
            }
        }
    }

    if ((sMyHpPct > minHeavyHp) && (AI_CHK_MYABLESKIL(279) == 1))
    {
        uid = AI_GET_UNIWEAK(0);
        if (uid != -1)
        {
            if (AI_CHK_UNIANALYZE_OPEN(uid, 0) == 0)
            {
                uid = -1;
            }
        }
        if (uid == -1)
        {
            if (preferHighHp == 1)
            {
                uid = AI_GET_UNINOMALLVMAXHPMAX(0);
            }
            if (uid == -1)
            {
                uid = AI_GET_UNINOMALHPMIN(0);
            }
        }
        if (uid != -1)
        {
            if (AI_CHK_UNIHOJO(uid, 0x4000) == 0)
            {
                AI_ACT_SKILL(279);
                AI_TAR_UID(uid);
                sActionDone = 10;
                return;
            }
        }
    }

    if ((allowAoE == 1) && (sMyHpPct > 40) && (AI_CHK_MYABLESKIL(291) == 1))
    {
        if ((AI_CHK_MYHOJO(0x0100) == 1) || (sOrder == 2) || ((sIsBoss == 0) && (sDownCount < sEnemyCount) && (IsAttrKnownImpeded(0) == 0)))
        {
            if ((IsAoESafeForAttr(0) == 1) || ((sEnemyCount == 1) && (IsSinglePhysSafe() == 1) && (IsAttrKnownImpeded(0) == 0)))
            {
                AI_ACT_SKILL(291);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
        }
    }
}

// Gun skills (224..228) intentionally ignore sNotPhysical so allies can hit flying enemies.
void TryGunSkills(int hpMin, int heavyHpMin, int preferHighHp)
{
    int uid;
    int gunAoESafe;
    int gunSingleSafe;

    if ((sLockMode == 1) || (sMyHpPct <= hpMin))
    {
        return;
    }

    gunAoESafe = IsAoESafeForAttr(1);
    gunSingleSafe = 0;
    if ((AI_CHK_ENMUKOU(1) == 0) && (AI_CHK_ENHANSYA(1) == 0) && (AI_CHK_ENKYUSYU(1) == 0) && (AI_CHK_ENHOJO(0x4000) == 0))
    {
        gunSingleSafe = 1;
    }

    if (gunAoESafe == 1)
    {
        if ((sMyHpPct > heavyHpMin) && (AI_CHK_MYABLESKIL(227) == 1))
        {
            AI_ACT_SKILL(227);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
        if (AI_CHK_MYABLESKIL(225) == 1)
        {
            AI_ACT_SKILL(225);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
    }

    if ((AI_CHK_MYABLESKIL(226) == 1) || (AI_CHK_MYABLESKIL(228) == 1) || (AI_CHK_MYABLESKIL(224) == 1))
    {
        uid = AI_GET_UNIWEAK(1);
        if (uid != -1)
        {
            if (AI_CHK_UNIANALYZE_OPEN(uid, 1) == 0)
            {
                uid = -1;
            }
        }
        if (uid == -1)
        {
            if (preferHighHp == 1)
            {
                uid = AI_GET_UNINOMALLVMAXHPMAX(1);
            }
            if (uid == -1)
            {
                uid = AI_GET_UNINOMALHPMIN(1);
            }
        }
        if (uid != -1)
        {
            if (AI_CHK_UNIHOJO(uid, 0x4000) == 0)
            {
                if (AI_CHK_MYABLESKIL(226) == 1)
                {
                    AI_ACT_SKILL(226);
                    AI_TAR_UID(uid);
                    sActionDone = 10;
                    return;
                }
                if (AI_CHK_MYABLESKIL(228) == 1)
                {
                    AI_ACT_SKILL(228);
                    AI_TAR_UID(uid);
                    sActionDone = 10;
                    return;
                }
                if (AI_CHK_MYABLESKIL(224) == 1)
                {
                    AI_ACT_SKILL(224);
                    AI_TAR_UID(uid);
                    sActionDone = 10;
                    return;
                }
            }
        }
    }

    if ((sEnemyCount == 1) && (gunSingleSafe == 1))
    {
        if ((sMyHpPct > heavyHpMin) && (AI_CHK_MYABLESKIL(227) == 1))
        {
            AI_ACT_SKILL(227);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
        if (AI_CHK_MYABLESKIL(225) == 1)
        {
            AI_ACT_SKILL(225);
            AI_TAR_RND();
            sActionDone = 10;
            return;
        }
    }
}

// aggressive: 0=Act Freely (HP>35%, SP>15%), 1=Full Assault (HP>30%, SP>0%).
// AI_ACT_HIGHSKILL: 1=AoE Mag, 2=AoE Phys, 3=ST Mag, 4=ST Phys, 5=Magic fallback.
void ACT_BestOffense(int aggressive)
{
    int hpMin;
    int spMin;
    int heavyHpMin;
    int attr;
    int uid;
    int singleOnly;
    int skill;
    int res;
    int skipAttr;
    int magicFirst;

    if (aggressive == 1)
    {
        hpMin = 30;
        heavyHpMin = 35;
        spMin = 0;
    }
    else
    {
        hpMin = 35;
        heavyHpMin = 40;
        spMin = 15;
    }

    magicFirst = 0;
    if ((sIsHealerChar == 1) || (sMyCharId == 4))
    {
        magicFirst = 1;
    }

    if ((AI_CHK_MYHOJO(0x0100) == 1) && (sLockMode != 1) && (sMyHpPct > 30))
    {
        if (sNotPhysical == 0)
        {
            TrySignaturePhysSkills(1, 35, 1);
            if (sActionDone != 0) { return; }

            if (IsAoESafeForAttr(0) == 1)
            {
                res = AI_ACT_HIGHSKILL(2);
                if ((res != -1) && (res != 0))
                {
                    sActionDone = 10;
                    return;
                }
            }
            if (AI_CHK_ENHOJO(0x4000) == 0)
            {
                res = AI_ACT_HIGHSKILL(4);
                if ((res != -1) && (res != 0))
                {
                    sActionDone = 10;
                    return;
                }
            }
            if ((sEnemyCount == 1) && (IsSinglePhysSafe() == 1))
            {
                res = AI_ACT_HIGHSKILL(2);
                if ((res != -1) && (res != 0))
                {
                    sActionDone = 10;
                    return;
                }
            }
        }
        TryGunSkills(30, 35, 1);
        if (sActionDone != 0) { return; }
    }

    if ((AI_CHK_MYHOJO(0x0200) == 1) && (sLockMode != 2))
    {
        if ((AI_CHK_MYABLESKIL(297) == 1) && ((sIsBoss == 1) || ((aggressive == 1) && (sMySpPct >= 35) && (AI_CHK_ENALLHP(40) == 0))))
        {
            AI_ACT_SKILL(297);
            if (AI_CHK_ENBAD(0x00100000) == 1)
            {
                AI_TAR_BAD(0x00100000);
            }
            else
            {
                AI_TAR_HPMAX();
            }
            sActionDone = 10;
            return;
        }

        if (AI_CHK_ENHOJO(0x8000) == 0)
        {
            if ((sEnemyCount > 1) && (sIsUnstable == 0) && (sSingleOnlyFlag == 0))
            {
                res = AI_ACT_HIGHSKILL(1);
                if ((res != -1) && (res != 0))
                {
                    sActionDone = 10;
                    return;
                }
            }
            res = AI_ACT_HIGHSKILL(3);
            if ((res != -1) && (res != 0))
            {
                sActionDone = 10;
                return;
            }
            if (sEnemyCount == 1)
            {
                res = AI_ACT_HIGHSKILL(1);
                if ((res != -1) && (res != 0))
                {
                    sActionDone = 10;
                    return;
                }
            }
        }
        else if ((sEnemyCount == 1) || ((sIsUnstable == 0) && (sSingleOnlyFlag == 0)))
        {
            // Almighty AoE (72/71/70) bypasses Makarakarn (0x8000).
            if (AI_CHK_MYABLESKIL(72) == 1) { AI_ACT_SKILL(72); AI_TAR_RND(); sActionDone = 10; return; }
            if (AI_CHK_MYABLESKIL(71) == 1) { AI_ACT_SKILL(71); AI_TAR_RND(); sActionDone = 10; return; }
            if (AI_CHK_MYABLESKIL(70) == 1) { AI_ACT_SKILL(70); AI_TAR_RND(); sActionDone = 10; return; }
        }
    }

    attr = 0;
    while (attr <= 9)
    {
        skipAttr = 0;
        if (((attr == 0) || (attr == 1)) && ((sLockMode == 1) || (sMyHpPct <= hpMin) || ((attr == 0) && (sNotPhysical == 1))))
        {
            skipAttr = 1;
        }
        if ((attr >= 2) && ((sLockMode == 2) || (sMySpPct <= spMin)))
        {
            skipAttr = 1;
        }

        if (skipAttr == 0)
        {
            uid = AI_GET_UNIWEAK(attr);
            if (uid != -1)
            {
                if ((AI_CHK_UNIANALYZE_OPEN(uid, attr) == 1) && (((attr <= 1) && (AI_CHK_UNIHOJO(uid, 0x4000) == 0)) || ((attr >= 2) && (AI_CHK_UNIHOJO(uid, 0x8000) == 0))))
                {
                    if (IsAoESafeForAttr(attr) == 1)
                    {
                        singleOnly = 0;
                    }
                    else
                    {
                        singleOnly = 1;
                    }

                    skill = AI_GET_UNIBESTATTRSKIL(uid, attr, singleOnly);
                    if ((skill <= 0) && (singleOnly == 1) && (sEnemyCount == 1))
                    {
                        skill = AI_GET_UNIBESTATTRSKIL(uid, attr, 0);
                    }
                    if (skill > 0)
                    {
                        sTargetUid = uid;
                        sSkillId = skill;
                        sActionDone = 1;
                        return;
                    }
                }
            }
        }

        attr = attr + 1;
    }

    if ((sMyHpPct > hpMin) && ((sIsBoss == 1) || (aggressive == 1) || (AI_CHK_ENALLHP(25) == 0)))
    {
        TrySignaturePhysSkills(1, heavyHpMin, sIsBoss);
        if (sActionDone != 0) { return; }
    }

    if ((sMyCharId == 7) && (IsAttrKnownImpeded(1) == 0) && ((sIsBoss == 1) || (aggressive == 1) || (AI_CHK_ENALLHP(25) == 0)))
    {
        TryGunSkills(hpMin, heavyHpMin, sIsBoss);
        if (sActionDone != 0) { return; }
    }

    if (sSingleOnlyFlag == 1)
    {
        if (magicFirst == 1)
        {
            if ((sLockMode != 2) && (sMySpPct > spMin) && (AI_CHK_ENHOJO(0x8000) == 0))
            {
                res = AI_ACT_HIGHSKILL(3);
                if ((res != -1) && (res != 0)) { sActionDone = 10; return; }
            }
            if ((sNotPhysical == 0) && (sLockMode != 1) && (sMyHpPct > hpMin) && (AI_CHK_ENHOJO(0x4000) == 0))
            {
                res = AI_ACT_HIGHSKILL(4);
                if ((res != -1) && (res != 0)) { sActionDone = 10; return; }
            }
        }
        else
        {
            if ((sNotPhysical == 0) && (sLockMode != 1) && (sMyHpPct > hpMin) && (AI_CHK_ENHOJO(0x4000) == 0))
            {
                res = AI_ACT_HIGHSKILL(4);
                if ((res != -1) && (res != 0)) { sActionDone = 10; return; }
            }
            if ((sLockMode != 2) && (sMySpPct > spMin) && (AI_CHK_ENHOJO(0x8000) == 0))
            {
                res = AI_ACT_HIGHSKILL(3);
                if ((res != -1) && (res != 0)) { sActionDone = 10; return; }
            }
        }
    }

    if ((sEnemyCount > 1) && (sIsUnstable == 0))
    {
        if (magicFirst == 1)
        {
            if ((sLockMode != 2) && (sMySpPct > spMin) && (AI_CHK_ENHOJO(0x8000) == 0))
            {
                res = AI_ACT_HIGHSKILL(1);
                if ((res != -1) && (res != 0)) { sActionDone = 10; return; }
            }
            if ((sNotPhysical == 0) && (sLockMode != 1) && (sMyHpPct > hpMin) && (IsAoESafeForAttr(0) == 1))
            {
                res = AI_ACT_HIGHSKILL(2);
                if ((res != -1) && (res != 0)) { sActionDone = 10; return; }
            }
        }
        else
        {
            if ((sNotPhysical == 0) && (sLockMode != 1) && (sMyHpPct > hpMin) && (IsAoESafeForAttr(0) == 1))
            {
                res = AI_ACT_HIGHSKILL(2);
                if ((res != -1) && (res != 0)) { sActionDone = 10; return; }
            }
            if ((sLockMode != 2) && (sMySpPct > spMin) && (AI_CHK_ENHOJO(0x8000) == 0))
            {
                res = AI_ACT_HIGHSKILL(1);
                if ((res != -1) && (res != 0)) { sActionDone = 10; return; }
            }
        }
    }

    if (sSingleOnlyFlag == 0)
    {
        if (magicFirst == 1)
        {
            if ((sLockMode != 2) && (sMySpPct > spMin) && (AI_CHK_ENHOJO(0x8000) == 0))
            {
                res = AI_ACT_HIGHSKILL(3);
                if ((res != -1) && (res != 0)) { sActionDone = 10; return; }
            }
            if ((sNotPhysical == 0) && (sLockMode != 1) && (sMyHpPct > hpMin) && (AI_CHK_ENHOJO(0x4000) == 0))
            {
                res = AI_ACT_HIGHSKILL(4);
                if ((res != -1) && (res != 0)) { sActionDone = 10; return; }
            }
        }
        else
        {
            if ((sNotPhysical == 0) && (sLockMode != 1) && (sMyHpPct > hpMin) && (AI_CHK_ENHOJO(0x4000) == 0))
            {
                res = AI_ACT_HIGHSKILL(4);
                if ((res != -1) && (res != 0)) { sActionDone = 10; return; }
            }
            if ((sLockMode != 2) && (sMySpPct > spMin) && (AI_CHK_ENHOJO(0x8000) == 0))
            {
                res = AI_ACT_HIGHSKILL(3);
                if ((res != -1) && (res != 0)) { sActionDone = 10; return; }
            }
        }
    }

    if (sEnemyCount == 1)
    {
        if (magicFirst == 1)
        {
            if ((sLockMode != 2) && (sMySpPct > spMin) && (AI_CHK_ENHOJO(0x8000) == 0))
            {
                res = AI_ACT_HIGHSKILL(1);
                if ((res != -1) && (res != 0)) { sActionDone = 10; return; }
            }
            if ((sNotPhysical == 0) && (sLockMode != 1) && (sMyHpPct > hpMin) && (IsSinglePhysSafe() == 1))
            {
                res = AI_ACT_HIGHSKILL(2);
                if ((res != -1) && (res != 0)) { sActionDone = 10; return; }
            }
        }
        else
        {
            if ((sNotPhysical == 0) && (sLockMode != 1) && (sMyHpPct > hpMin) && (IsSinglePhysSafe() == 1))
            {
                res = AI_ACT_HIGHSKILL(2);
                if ((res != -1) && (res != 0)) { sActionDone = 10; return; }
            }
            if ((sLockMode != 2) && (sMySpPct > spMin) && (AI_CHK_ENHOJO(0x8000) == 0))
            {
                res = AI_ACT_HIGHSKILL(1);
                if ((res != -1) && (res != 0)) { sActionDone = 10; return; }
            }
        }
    }

    if ((sLockMode != 2) && (sMySpPct > spMin) && (AI_CHK_ENHOJO(0x8000) == 1) && ((sEnemyCount == 1) || ((sIsUnstable == 0) && (sSingleOnlyFlag == 0))))
    {
        if (AI_CHK_MYABLESKIL(72) == 1) { AI_ACT_SKILL(72); AI_TAR_RND(); sActionDone = 10; return; }
        if (AI_CHK_MYABLESKIL(71) == 1) { AI_ACT_SKILL(71); AI_TAR_RND(); sActionDone = 10; return; }
        if (AI_CHK_MYABLESKIL(70) == 1) { AI_ACT_SKILL(70); AI_TAR_RND(); sActionDone = 10; return; }
    }

    if ((sIsBoss == 1) || (aggressive == 1) || (AI_CHK_ENALLHP(25) == 0))
    {
        TryGunSkills(hpMin, heavyHpMin, sIsBoss);
    }
}

// Conserve SP HP-cost Phys/Gun: keep uncharged HP floor high (55%) so HP skills don't force SP healing.
void ACT_PhysZeroSP()
{
    int uid;
    int skill;
    int singleOnly;
    int res;
    int isCharged;
    int hpMin;
    int heavyHpMin;
    int preferHigh;

    if (sLockMode == 1)
    {
        return;
    }

    isCharged = AI_CHK_MYHOJO(0x0100);
    if (isCharged == 1)
    {
        hpMin = 35;
        heavyHpMin = 40;
        preferHigh = 1;
    }
    else
    {
        hpMin = 55;
        heavyHpMin = 60;
        preferHigh = sIsBoss;
    }

    if ((sNotPhysical == 0) && (sNo1MoreFlag == 0) && (sDownCount < sEnemyCount) && (isCharged == 0))
    {
        res = AI_GET_MYATTRATTACK();
        uid = AI_GET_UNIWEAK_ST(res);
        if (uid != -1)
        {
            if ((AI_CHK_UNIANALYZE_OPEN(uid, res) == 1) && (AI_CHK_UNIBAD(uid, 4) == 0) && (AI_CHK_UNIHOJO(uid, 0x4000) == 0))
            {
                AI_ACT_ATTACK();
                AI_TAR_UID(uid);
                sActionDone = 10;
                return;
            }
        }
    }

    if (sMyHpPct <= hpMin)
    {
        return;
    }

    uid = AI_GET_UNIWEAK_ST(1);
    if (uid != -1)
    {
        if ((AI_CHK_UNIANALYZE_OPEN(uid, 1) == 1) && (AI_CHK_UNIHOJO(uid, 0x4000) == 0))
        {
            if (IsAoESafeForAttr(1) == 1) { singleOnly = 0; } else { singleOnly = 1; }
            skill = AI_GET_UNIBESTATTRSKIL(uid, 1, singleOnly);
            if ((skill <= 0) && (singleOnly == 1) && (sEnemyCount == 1))
            {
                skill = AI_GET_UNIBESTATTRSKIL(uid, 1, 0);
            }
            if (skill > 0)
            {
                sTargetUid = uid;
                sSkillId = skill;
                sActionDone = 1;
                return;
            }
        }
    }

    if (sNotPhysical == 1)
    {
        if ((isCharged == 1) || (sIsBoss == 1) || (AI_CHK_ENALLHP(25) == 0))
        {
            TryGunSkills(hpMin, heavyHpMin, preferHigh);
        }
        return;
    }

    uid = AI_GET_UNIWEAK_ST(0);
    if (uid != -1)
    {
        if ((AI_CHK_UNIANALYZE_OPEN(uid, 0) == 1) && (AI_CHK_UNIHOJO(uid, 0x4000) == 0))
        {
            if (IsAoESafeForAttr(0) == 1) { singleOnly = 0; } else { singleOnly = 1; }
            skill = AI_GET_UNIBESTATTRSKIL(uid, 0, singleOnly);
            if ((skill <= 0) && (singleOnly == 1) && (sEnemyCount == 1))
            {
                skill = AI_GET_UNIBESTATTRSKIL(uid, 0, 0);
            }
            if (skill > 0)
            {
                sTargetUid = uid;
                sSkillId = skill;
                sActionDone = 1;
                return;
            }
        }
    }

    if ((isCharged == 0) && (sIsBoss == 0) && (AI_CHK_ENALLHP(25) == 1))
    {
        return;
    }

    TrySignaturePhysSkills(1, heavyHpMin, preferHigh);
    if (sActionDone != 0)
    {
        return;
    }

    if (IsAoESafeForAttr(0) == 1)
    {
        res = AI_ACT_HIGHSKILL(2);
        if ((res != -1) && (res != 0))
        {
            sActionDone = 10;
            return;
        }
    }

    if (AI_CHK_ENHOJO(0x4000) == 0)
    {
        res = AI_ACT_HIGHSKILL(4);
        if ((res != -1) && (res != 0))
        {
            sActionDone = 10;
            return;
        }
    }

    if ((sEnemyCount == 1) && (IsSinglePhysSafe() == 1))
    {
        res = AI_ACT_HIGHSKILL(2);
        if ((res != -1) && (res != 0))
        {
            sActionDone = 10;
            return;
        }
    }

    TryGunSkills(hpMin, heavyHpMin, preferHigh);
}

void ACT_AttackOrGuard()
{
    int myAttr;
    int uid;
    int res;

    if ((sNotPhysical == 1) || (sLockMode == 1))
    {
        if ((sLockMode != 1) && (sNo1MoreFlag == 0) && (AI_CHK_MYHOJO(0x0100) == 0) && (AI_GET_BULLET() > 0))
        {
            uid = AI_GET_UNIWEAK(1);
            if (uid != -1)
            {
                if (AI_CHK_UNIANALYZE_OPEN(uid, 1) == 0)
                {
                    uid = -1;
                }
            }
            if (uid == -1)
            {
                uid = AI_GET_UNINOMALHPMIN(1);
            }
            if (uid != -1)
            {
                if (AI_CHK_UNIHOJO(uid, 0x4000) == 0)
                {
                    if ((sMyCharId != 4) && (sMyCharId != 7))
                    {
                        AI_ACT_GUN();
                        AI_TAR_UID(uid);
                        sActionDone = 10;
                        return;
                    }
                    else if (IsAoEGunSafe() == 1)
                    {
                        AI_ACT_GUN();
                        AI_TAR_UID(uid);
                        sActionDone = 10;
                        return;
                    }
                }
            }
        }

        if ((sOrder != 2) && ((sOrder != 3) || (sMySpPct >= 25)) && (sLockMode != 2) && (AI_CHK_MYBAD(0x40) == 0) && (AI_CHK_ENHOJO(0x8000) == 0))
        {
            res = AI_ACT_HIGHSKILL(5);
            if ((res != -1) && (res != 0))
            {
                sActionDone = 10;
                return;
            }
        }

        if (sLockMode != 5)
        {
            AI_ACT_DEFENSE();
            sActionDone = 10;
            return;
        }
    }

    myAttr = AI_GET_MYATTRATTACK();

    // Skip basic melee & Gun while Charged (0x0100) so fallback uses Magic/Guard and preserves the 2.5x buff.
    if (AI_CHK_MYHOJO(0x0100) == 0)
    {
        if ((sNo1MoreFlag == 0) && (sDownCount < sEnemyCount))
        {
            uid = AI_GET_UNIWEAK_ST(myAttr);
            if (uid != -1)
            {
                if ((AI_CHK_UNIANALYZE_OPEN(uid, myAttr) == 1) && (AI_CHK_UNIBAD(uid, 4) == 0) && (AI_CHK_UNIHOJO(uid, 0x4000) == 0))
                {
                    AI_ACT_ATTACK();
                    AI_TAR_UID(uid);
                    sActionDone = 10;
                    return;
                }
            }
        }

        if ((AI_CHK_ENBAD(0x02) == 1) && (AI_CHK_ENHOJO(0x4000) == 0))
        {
            AI_ACT_ATTACK();
            AI_TAR_BAD(0x02);
            sActionDone = 10;
            return;
        }

        uid = AI_GET_UNIWEAK(myAttr);
        if (uid != -1)
        {
            if ((AI_CHK_UNIANALYZE_OPEN(uid, myAttr) == 1) && (AI_CHK_UNIBAD(uid, 4) == 0) && (AI_CHK_UNIHOJO(uid, 0x4000) == 0))
            {
                AI_ACT_ATTACK();
                AI_TAR_UID(uid);
                sActionDone = 10;
                return;
            }
        }

        uid = AI_GET_UNI_NOANALYZE(myAttr);
        if (uid != -1)
        {
            if ((AI_CHK_UNIBAD(uid, 4) == 0) && (AI_CHK_UNIHOJO(uid, 0x4000) == 0))
            {
                AI_ACT_ATTACK();
                AI_TAR_UID(uid);
                sActionDone = 10;
                return;
            }
        }

        uid = AI_GET_UNINOMALHPMIN(myAttr);
        if (uid != -1)
        {
            if ((AI_CHK_UNIBAD(uid, 4) == 0) && (AI_CHK_UNIHOJO(uid, 0x4000) == 0))
            {
                AI_ACT_ATTACK();
                AI_TAR_UID(uid);
                sActionDone = 10;
                return;
            }
        }

        uid = AI_GET_UNI_ATTACK();
        if (uid != -1)
        {
            if ((AI_CHK_UNIBAD(uid, 4) == 0) && (AI_CHK_UNIHOJO(uid, 0x4000) == 0))
            {
                AI_ACT_ATTACK();
                AI_TAR_UID(uid);
                sActionDone = 10;
                return;
            }
        }
    }

    if ((sLockMode != 1) && (sNo1MoreFlag == 0) && (AI_CHK_MYHOJO(0x0100) == 0) && (AI_GET_BULLET() > 0))
    {
        uid = AI_GET_UNIWEAK(1);
        if (uid != -1)
        {
            if (AI_CHK_UNIANALYZE_OPEN(uid, 1) == 0)
            {
                uid = -1;
            }
        }
        if (uid == -1)
        {
            uid = AI_GET_UNINOMALHPMIN(1);
        }
        if (uid != -1)
        {
            if (AI_CHK_UNIHOJO(uid, 0x4000) == 0)
            {
                if ((sMyCharId != 4) && (sMyCharId != 7))
                {
                    AI_ACT_GUN();
                    AI_TAR_UID(uid);
                    sActionDone = 10;
                    return;
                }
                else if (IsAoEGunSafe() == 1)
                {
                    AI_ACT_GUN();
                    AI_TAR_UID(uid);
                    sActionDone = 10;
                    return;
                }
            }
        }
    }

    if ((sOrder != 2) && ((sOrder != 3) || (sMySpPct >= 25)) && (sLockMode != 2) && (AI_CHK_MYBAD(0x40) == 0) && (AI_CHK_ENHOJO(0x8000) == 0))
    {
        res = AI_ACT_HIGHSKILL(5);
        if ((res != -1) && (res != 0))
        {
            sActionDone = 10;
            return;
        }
    }

    if (sLockMode != 5)
    {
        AI_ACT_DEFENSE();
        sActionDone = 10;
        return;
    }

    AI_ACT_ATTACK();
    AI_TAR_RND();
    sActionDone = 10;
}
