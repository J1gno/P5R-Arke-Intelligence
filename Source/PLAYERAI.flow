            }
            if (AI_CHK_MYABLESKIL(341) == 1)
            {
                AI_ACT_SKILL(341);
                AI_TAR_RND();
                sActionDone = 10;
                return;
            }
            if ((AI_CHK_MYABLESKIL(336) == 1) && (AI_GET_FRHOJO_ON(0x10) < 2) && ((sIsBoss == 1) || ((allyId == 1) && (sMySpPct >= 30) && (AI_CHK_ENALLHP(40) == 0))))
            {
                AI_ACT_SKILL(336);
                AI_TAR_UID(AI_GET_UNI(0, allyId));
                sActionDone = 10;
